    )}
    </Div>
  );

  // NEWVYA-1218: the receipt body is shared by the modal (Event screen) and the
  // inline panel (History page) so both render the EXACT same invoice.
  const receiptBody = (
    <ScrollView showsVerticalScrollIndicator={false}>
      <Text style={styles.resMainHeading}> RESTAURANT </Text>
      <Text style={styles.resMainHeading}> {appointment?.restaurant?.name} </Text>
      {/* NEWVYA-1171: route to the WHOLE-BILL receipt (personOrderList, which sums
         every user's preordered_products) ONLY for the true event invoice — i.e. no
         person selected (''), or the selected invoice IS the appointment itself.
         A PAID individual (e.g. someone who paid their own preorder) used to match
         the old `singleInvoice?.payment_completed` branch and fall into the whole-bill
         view, leaking OTHER users' preorder totals/products onto this person's
         receipt. singleInvoiceBill filters the Pre-Order block by singleInvoice==e._id,
         so individuals (paid or not) must use it. Payment card was already correct. */}
      {(singleInvoice == '' || singleInvoice?._id == appointment?._id) ? personOrderList : singleInvoiceBill}

      <Text style={styles.resMainHeading}> Thanks for visiting </Text>
      <Text style={styles.resMainHeading}> TEL: 26 31 34 56</Text>
    </ScrollView>
  );

  // NEWVYA-1218: inline mode for the History page — same receipt, no modal chrome,
  // fills the host container instead of floating as a centered overlay.
  if (inline) {
    return (
      <Div flex={1} bg='white' p={30}>
        {receiptBody}
      </Div>
    );
  }

  return (
    <ReactNativeModal
      visible={visible}
      aria-modal={true}
      style={{ backgroundColor: "rgba(0, 0, 0, 0.4)", margin: 0 }}
      onBackdropPress={() => {
        onClose();
      }}>
      <Div
        w={500}
        h={750}
        mx={'30%'} my={'30%'}
        p={30}
        bg='white'
      >
        {receiptBody}
      </Div>
    </ReactNativeModal>
  )
}

export const PaymentForModal = ({
  visible,
  onClose,
  usersList,
  guestList,
  currPayingUser,
  onApply
}) => {
  const [selectedUser, setSelectedUser] = useState([]);

  useEffect(() => {
    if (visible) {
      setSelectedUser([currPayingUser?._id] || []);
    }
  }, [visible]);

  useEffect(() => {
    if (
      visible &&
      currPayingUser &&
      currPayingUser !== null &&
      !_.isEmpty(currPayingUser.payed_for)
    ) {
      let ids = [currPayingUser._id];
      currPayingUser.payed_for.forEach((e) => {
        ids.push(e._id);
      });
      setSelectedUser(ids);
    }
  }, [currPayingUser, visible]);

  const handleSelectedUsers = (id) => {
    setSelectedUser((prevSelected) =>
      prevSelected.includes(id)
        ? prevSelected.filter((er) => er !== id)
        : [...prevSelected, id]
    );
  };


  const getInitial = (val) => {
    var initial = val?.charAt(0) != undefined && val?.charAt(0)?.toUpperCase();
    return initial;
  };

  // Function to sort users with currPayingUser first
  const getSortedUsersList = (users) => {
    if (!currPayingUser?._id) return users;

    const filteredUsers = users.filter(
      user => !user.payment_completed && user?.products?.length !== 0
    );

    const currentUserIndex = filteredUsers.findIndex(user => user._id === currPayingUser._id);

    if (currentUserIndex === -1) return filteredUsers;

    const currentUser = filteredUsers[currentUserIndex];
    const otherUsers = filteredUsers.filter((_, index) => index !== currentUserIndex);

    return [currentUser, ...otherUsers];
  };

  return (
    <ReactNativeModal
      visible={visible}
      accessible={false}
      style={{ backgroundColor: 'rgba(0, 0, 0, 0.4)', margin: 0 }}
      onBackdropPress={onClose}
    >
      <Div
        w={550}
        rounded={43}
        alignSelf="center"
        maxH={'85%'}
        bg="white"
        p={30}
      >
        <Text
          style={{
            fontSize: 21,
            fontFamily: Fonts.type.sfpSemiBold,
            color: '#000000',
            textAlign: 'center',
          }}
        >

          For whom do you like to pay... ?
        </Text>
        <Div>
          <ScrollView horizontal showsHorizontalScrollIndicator={false}>
            {getSortedUsersList(usersList).map((er) => (
              <Div
                key={er._id}
                py={12}
                px={10}
                mt={30}
                mb={20}
              >
                {selectedUser.some((val) => val === er._id) ? (
                  <TouchableOpacity
                    accessible={true}
                    accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                    onPress={() => handleSelectedUsers(er._id)}
                    style={{
                      position: 'absolute',
                      right: 7,
                      top: 5,
                      zIndex: 1000,
                    }}>
                    <Icon
                      name="closecircle"
                      color="black"
                      fontFamily="AntDesign"
                      fontSize="xl"
                    />
                  </TouchableOpacity>
                ) : null}
                <TouchableOpacity
                  accessible={true}
                  accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                  onPress={() => handleSelectedUsers(er._id)}>
                  <ParticipantAvatarName username={er.username} image={er.profile_image} />
                </TouchableOpacity>
              </Div>
            ))}
            {getSortedUsersList(guestList).map((er) => (
              <Div
                key={er._id}
                py={12}
                px={10}
                mt={30}
                mb={20}
              >
                {selectedUser.some((val) => val === er._id) ? (
                  <TouchableOpacity
                    accessible={true}
                    accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                    onPress={() => handleSelectedUsers(er._id)}
                    style={{
                      position: 'absolute',
                      right: 7,
                      top: 5,
                      zIndex: 1000,
                    }}>
                    <Icon
                      name="closecircle"
                      color="black"
                      fontFamily="AntDesign"
                      fontSize="xl"
                    />
                  </TouchableOpacity>
                ) : null}
                <TouchableOpacity
                  accessible={true}
                  accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                  onPress={() => handleSelectedUsers(er._id)}>
                  <ParticipantAvatarName username={er.username} image={er.profile_image} />
                </TouchableOpacity>
              </Div>
            ))}
          </ScrollView>
        </Div>

        <Button
          accessibilityLabel={'applyPayment'}
          py={22}
          disabled={_.isEmpty(selectedUser)}
          px={162}
          bg={_.isEmpty(selectedUser) ? Colors.silver : Colors.active}
          rounded={16}
          onPress={() => onApply(selectedUser)}
          mt={14}
          shadow="md"
          borderless
          alignSelf="center"
        >
          <Text
            style={{
              fontSize: 17,
              color: _.isEmpty(selectedUser) ? Colors.loblolly : Colors.snow,
              fontFamily: Fonts.type.sfpSemiBold,
            }}
          >
            Apply
          </Text>
        </Button>
      </Div>
    </ReactNativeModal>
  );
}; 

export class ProductRegistered extends React.Component {
  constructor(props) {
    super(props);
    this.state = {};
  }
  render() {
    const {completed, onClose} = this.props;
    return (
      <Overlay
        w={896}
        h={390}
        visible={completed}
        rounded={43}
        // onBackdropPress={() => onClose()}
      >
        <Div justifyContent="center" row pt={120}>
          <Div
            backgroundColor="#ED782F"
            rounded="circle"
            w={120}
            h={120}
            justifyContent="center"
            alignSelf="center">
            <Icon
              alignSelf="center"
              name="md-calendar-sharp"
              color={Colors.snow}
              fontSize={60}
              fontFamily="Ionicons"
            />
          </Div>
          <Div justifyContent="center" alignItems="center" ml={32}>
            <Div>
              <Text
                style={{
                  color: Colors.active,
                  fontFamily: Fonts.type.sfpSemiBold,
                  fontSize: 17,
                  textAlign: 'center',
                }}>
                Product Registered
              </Text>
            </Div>
            <Div w={368} h={70} alignItems="center" justifyContent="center">
              <Text
                style={{
                  fontFamily: Fonts.type.sfpRegular,
                  fontSize: 15,
                  textAlign: 'center',
                }}>
                You can update and check if your product has been validated from
                the web app portal
              </Text>
            </Div>
          </Div>
        </Div>
        <Div row justifyContent="space-around">
          <Button
            py={22}
            px={152}
            onPress={() => onClose()}
            bg={Colors.active}
            rounded={16}
            mt={28}
            shadow="md"
            borderless
            alignSelf="center">
            <Text
              style={{
                fontSize: 17,
                color: Colors.snow,
                fontFamily: Fonts.type.sfpSemiBold,
              }}>
              Close
            </Text>
          </Button>
          <Button
            py={22}
            onPress={() => {
              Linking.openURL('https://api.vyapy.com');
              onClose();
            }}
            px={152}
            bg={Colors.silver}
            rounded={16}
            mt={28}
            shadow="md"
            borderless
            alignSelf="center">
            <Text
              style={{
                fontSize: 17,
                color: Colors.secondary,
                fontFamily: Fonts.type.sfpSemiBold,
              }}>
              Open Webapp
            </Text>
          </Button>
        </Div>
      </Overlay>
    );
  }
}

export class CompAndVoidModal extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      selectedUser: [],
      discountVal: [5, 10, 15, 25, 30, 40, 100],
      compReasonsList : [
        { label : 'Birthday', accessibilityLabel : 'birthday' },
        { label : 'Manager Discretion', accessibilityLabel : 'managerDiscretion' },
        {
          label : 'Service Recovery',
          accessibilityLabel : 'serviceRecovery',
          description : 'Service issues, delayed orders, product quality concerns, customer dissatisfaction, or goodwill gestures.',
        },
      ],
      voidReasonsList : [
        { label : 'Entry Error', accessibilityLabel : 'entryError' },
        { label : 'Customer Changed Mind', accessibilityLabel : 'customerChangedMind' },
        { label : 'Item Unavailable', accessibilityLabel : 'itemUnavailable' },
        { label : 'Duplicate Order', accessibilityLabel : 'duplicateOrder' },
        { label : 'Allergy / Dietary Concern', accessibilityLabel : 'allergyDietaryConcern' },
        { label : 'Manager Override', accessibilityLabel : 'managerOverride' },
      ],
      setCompDiscount : 0,
      setCompReason : '',
      otherReasonText : '',
    };
  }

  componentDidUpdate(prevProps, prevState) {
    const { product, visible } = this.props;
    if(!prevProps.visible && visible) {
      if(product.comp == true){
        this.setState({setCompDiscount: product.compDiscount, setCompReason : product.reason, otherReasonText : ''});
      }
      else {
        this.setState({setCompDiscount: 0, setCompReason : '', otherReasonText : ''});
      }
    }
  };

  render() {
    const {discountVal, setCompDiscount, setCompReason, compReasonsList, voidReasonsList, otherReasonText} = this.state;
    const {visible, onClose, onDone, product, voidCompSplit} = this.props;
    const finalReason = [setCompReason, otherReasonText.trim()].filter(Boolean).join(' - ');

    const renderReasonList = (reasonList, isVoid = false) => (
      <Surface style={Styles.uresSubDtSubSrf}>
        {reasonList.map((reason, idx) => (
          <React.Fragment key={reason.label}>
            {idx > 0 && <Divider />}
            <Radio
              accessible={true}
              accessibilityLabel={reason.accessibilityLabel}
              fontSize={17}
              style={{paddingVertical: isVoid ? 18 : 12, alignItems: reason.description ? 'flex-start' : 'center'}}
              onPress={() => {
                setCompReason === reason.label
                  ? this.setState({setCompReason: ''})
                  : this.setState({setCompReason: reason.label});
              }}
              checked={setCompReason == reason.label ? true : false}
              activeColor='#614577'
              suffix={
                <Div flex={1}>
                  <Text style={Styles.udpateTextContent}>
                    {reason.label}
                  </Text>
                  {reason.description ? (
                    <Text
                      style={{
                        fontSize: 12,
                        color: '#8E8E93',
                        marginLeft: 10,
                        marginTop: 2,
                        flexWrap: 'wrap',
                      }}>
                      {reason.description}
                    </Text>
                  ) : null}
                </Div>
              }/>
          </React.Fragment>
        ))}
      </Surface>
    );

    return (
      <Overlay
        w={500}
        h={voidCompSplit === 'Comp' ? 700 : 730}
        rounded={43}
        p={10}
        visible={visible}
        aria-modal={true}
        onBackdropPress={() => {
          onClose();
        }}>
        <KeyboardAvoidingView
          style={{flex: 1}}
          behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
          <ScrollView
            style={{flex: 1}}
            contentContainerStyle={{paddingTop: '2%', paddingBottom: 16}}
            showsVerticalScrollIndicator={false}
            keyboardShouldPersistTaps="handled">
            {voidCompSplit === "Comp" ? (
              <>
                <Text
                  style={{
                    fontSize: 21,
                    marginTop:'5%',
                    fontFamily: Fonts.type.sfpSemiBold,
                    color: '#000000',
                    textAlign: 'center',
                  }}>
                  Specify {<Text style={{color:'#614577'}}>COMP</Text>} reason
                </Text>
                <Div>
                  <Div>
                    {renderReasonList(compReasonsList, true)}
                  </Div>
                  <Div style={Styles.updateinputBlock}>
                    <TextInput
                      style={Styles.updateinputText}
                      placeholder='Add a note if other reason'
                      placeholderTextColor="#8E8E93"
                      accessibilityLabel='compOtherReasonInput'
                      value={otherReasonText}
                      onChangeText={(text) => this.setState({otherReasonText: text})}
                    />
                  </Div>
                  <Div>
                    <Text style={Styles.updateDiscountText}>
                      Apply Discount
                    </Text>
                    <ScrollView
                      horizontal
                      style={{marginHorizontal:'5%',marginTop:'5%',alignSelf:'center'}}
                      showsHorizontalScrollIndicator={false}>
                        {discountVal.map((el)=>(
                          <TouchableOpacity onPress={() => {setCompDiscount === el ? this.setState({setCompDiscount : 0}) : this.setState({setCompDiscount : el})}}>
                            <Chip
                              accessibilityLabel={`${el}Btn`}
                              height={32}
                              marginHorizontal={2}
                              style={[
                                Styles.uresSubDtSubSrfChip,
                                {backgroundColor : setCompDiscount === el ? "#E1E1E1" : null }
                              ]}>
                              <Text style={Styles.uresSubDtSubSrfChipTxt}>
                                {el} %
                              </Text>
                            </Chip>
                          </TouchableOpacity>
                        ))}
                    </ScrollView>
                  </Div>
                </Div>
              </>
            ) : (
              <>
                <Text
                  style={{
                    fontSize: 21,
                    marginTop:'5%',
                    fontFamily: Fonts.type.sfpSemiBold,
                    color: '#000000',
                    textAlign: 'center',
                  }}>
                  Specify {<Text style={{color:'#614577'}}>VOID</Text>} reason
                </Text>
                <Div>
                  <Div>
                    {renderReasonList(voidReasonsList, true)}
                  </Div>
                  <Div style={Styles.updateinputBlock}>
                    <TextInput
                      style={Styles.updateinputText}
                      placeholder='Add a note if other reason'
                      placeholderTextColor="#8E8E93"
                      accessibilityLabel='voidOtherReasonInput'
                      value={otherReasonText}
                      onChangeText={(text) => this.setState({otherReasonText: text})}
                    />
                  </Div>
                </Div>
              </>
            )}
          </ScrollView>
          <View style={Styles.voidConfirmBtnWrap}>
            <Button
              accessible={true}
              onPress={() =>
                voidCompSplit === 'Comp'
                  ? // selectedReason carries the radio on its own. finalReason
                    // merges it with the free-text note, so a note typed with no
                    // radio selected produced a non-empty string and satisfied
                    // compData's reason check - Comp went through without a
                    // reason. The merged string is still what reaches the API.
                    onDone({
                      setCompDiscount,
                      setCompReason: finalReason,
                      selectedReason: setCompReason,
                    })
                  : // Void keeps sending the merged string as its first argument
                    // (applyComp posts it straight through as `reason`); the
                    // radio rides along second so compData can require it.
                    onDone(finalReason, setCompReason)
              }
              accessibilityLabel="assignProductsBtn"
              py={22}
              mx={50}
              bg='#614577'
              rounded={16}
              style={{shadowColor: '#000000', shadowOffset: {width: 0, height: 2}, shadowOpacity: 0.12, shadowRadius: 6}}
              alignSelf="stretch">
              <Text
                style={{
                  fontSize: 17,
                  color:'#FFFFFF',
                  fontFamily: Fonts.type.sfpSemiBold,
                }}>
                Apply
              </Text>
            </Button>
          </View>
        </KeyboardAvoidingView>
      </Overlay>
    );
  }
}

export class CompAndVoidProductModal extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      Qty : 1,
    };
  }

  increment = () => {
    if(this.state.Qty < this.props.product.ordered_quantity){
      this.setState({Qty : this.state.Qty + 1})
    };
  };

  decrement = () => {
    if(this.state.Qty > 1){
      this.setState({Qty : this.state.Qty - 1})
    };
  };

  removeItem = () => {
    <></>
  };

  render() {
    const {visible, onClose, product, compResAndDis, onDone, voidCompSplit} = this.props;
    const {Qty} = this.state;

    return (
      <Overlay
        w={600}
        h={600}
        rounded={43}
        p={10}
        visible={visible}
        aria-modal={true}
        onBackdropPress={() => {
          onClose();
        }}>
        {voidCompSplit === "Comp" ? (
          <>
            <Text
              style={{
                fontSize: 28,
                marginTop:'5%',
                marginHorizontal: 20,
                fontFamily: Fonts.type.sfpSemiBold,
                color: '#000000',
                textAlign: 'center',
              }}>
              Specify {<Text style={{color:'#614577'}}>COMP</Text>} reason
            </Text>
            <Text
              style={{
                fontSize: 20,
                marginTop:'10%',
                marginBottom:'5%',
                marginHorizontal: 20,
                fontFamily: Fonts.type.sfpRegular,
                color: '#000000',
                textAlign: 'left',
                fontWeight:'600',
                opacity:0.7
              }}>
              Select which items to Comp
            </Text>
            <Divider  marginHorizontal={20}/>
            <Div flexDir='column' justifyContent='space-between' h={350} >
              <Div mt={'5%'} flexDir='column' justifyContent='space-between'>
                <Div row justifyContent='space-between' marginHorizontal={20}>
                  <Text style={Styles.updateCompName}>
                    {product.name}
                  </Text>
                  <Div style={Styles.updateCounterBtn}>
                    <CustomCounter
                      count={Qty}
                      increment={this.increment}
                      decrement={this.decrement}
                      removeItem={this.removeItem}
                    />
                  </Div>
                </Div>
                <Div marginHorizontal={35}>
                  {product?.features?.map((e)=>(
                    <>
                    {e.data.map((er,idx)=>(
                      <Div row>
                        <Text style={[Styles.updateCompSplName]}>
                          {'\u2022'} {er?.header} :
                        </Text>
                        {er?.items?.map((tr)=>(
                          tr?.selected && (
                            <Text style={[Styles.updateCompSplName,{paddingLeft:5,width:'65%'}]}>
                              {tr?.name}
                            </Text>
                          )
                        ))}
                      </Div>
                    ))}

                    {e?.data[0]?.specialinstructions != '' && e?.data[0]?.specialinstructions != undefined && (
                      <Div row >
                        <Text style={[Styles.updateCompSplName]}>
                          {'\u2022'} special Instructions :
                        </Text>
                        <Text style={[Styles.updateCompSplName]}>
                          {e?.data[0]?.specialinstructions}
                        </Text>
                      </Div>
                    )}
                    </>
                  ))}
                </Div>
              </Div> 
              <Button
                accessible={true}
                accessibilityLabel="assignProductsBtn"
                onPress={() => {onDone(product, Qty, compResAndDis), this.setState({Qty : 1})}}
                py={30}
                mx={50}
                bg='#614577'
                rounded={16}
                style={{shadowColor: '#000000', shadowOffset: {width: 0, height: 2}, shadowOpacity: 0.12, shadowRadius: 6}}
                alignSelf="stretch">
                <Text
                  style={{
                    fontSize: 17,
                    color:'#FFFFFF',
                    fontFamily: Fonts.type.sfpSemiBold,}}>
                  Next
                </Text>
              </Button>
            </Div>
          </>
        ) : (
          <>
            <Text
              style={{
                fontSize: 28,
                marginTop:'5%',
                marginHorizontal: 20,
                fontFamily: Fonts.type.sfpSemiBold,
                color: '#000000',
                textAlign: 'center',
              }}>
              Specify {<Text style={{color:'#614577'}}>Void</Text>} reason
            </Text>
            <Text
              style={{
                fontSize: 20,
                marginTop:'10%',
                marginBottom:'5%',
                marginHorizontal: 20,
                fontFamily: Fonts.type.sfpRegular,
                color: '#000000',
                textAlign: 'left',
                fontWeight:'600',
                opacity:0.7
              }}>
              Select which items to Void
            </Text>
            <Divider  marginHorizontal={20}/>
            <Div flexDir='column' justifyContent='space-between' h={350} >
              <Div mt={'5%'} flexDir='column' justifyContent='space-between'>
                <Div row justifyContent='space-between' marginHorizontal={20}>
                  <Text style={Styles.updateCompName}>
                    {product.name}
                  </Text>
                  <Div style={Styles.updateCounterBtn}>
                    <CustomCounter
                      count={Qty}
                      increment={this.increment}
                      decrement={this.decrement}
                      removeItem={this.removeItem}
                    />
                  </Div>
                </Div>
                <Div marginHorizontal={35}>
                  {product?.features?.map((e)=>(
                    <>
                    {e.data.map((er,idx)=>(
                      <Div row>
                        {er.header != undefined && (
                          <Text style={[Styles.updateCompSplName]}>
                            {'\u2022'} {er?.header} :
                          </Text>
                        )}
                        {er?.items?.map((tr)=>(
                          tr.selected && (
                            <Text style={[Styles.updateCompSplName,{paddingLeft:5,width:'65%'}]}>
                              {tr?.name}
                            </Text>
                          )
                        ))}
                      </Div>
                    ))}

                    {e?.data[0]?.specialinstructions != '' && e?.data[0]?.specialinstructions != undefined && (
                      <Div row >
                        <Text style={[Styles.updateCompSplName]}>
                          {'\u2022'} special Instructions :
                        </Text>
                        <Text style={[Styles.updateCompSplName]}>
                          {e?.data[0]?.specialinstructions}
                        </Text>
                      </Div>
                    )}
                    </>
                  ))}
                </Div>
              </Div> 
              <Button
                accessible={true}
                accessibilityLabel="ApplyBtn"
                onPress={() => {onDone(product, Qty, compResAndDis), this.setState({Qty : 1})}}
                py={30}
                mx={50}
                bg='#614577'
                rounded={16}
                style={{shadowColor: '#000000', shadowOffset: {width: 0, height: 2}, shadowOpacity: 0.12, shadowRadius: 6}}
                alignSelf="stretch">
                <Text
                  style={{
                    fontSize: 17,
                    color:'#FFFFFF',
                    fontFamily: Fonts.type.sfpSemiBold,}}>
                  Next
                </Text>
              </Button>
            </Div>
          </>
        )}
      </Overlay>
    );
  }
}

const styles = StyleSheet.create({
