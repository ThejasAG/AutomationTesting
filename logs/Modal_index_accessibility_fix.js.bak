function getTableAvlInfo(tableListArr) {
  return tableListArr.filter((listItem) => {
    if (listItem.bookedSlots.length) {
      if (
        moment(listItem.bookedSlots[0].booked_from).isBefore(
          moment(new Date()),
        ) ||
        moment(listItem.bookedSlots[0].booked_to).isAfter(moment(new Date()))
      ) {
        return listItem;
      }
    } else {
      return listItem;
    }
  });
}

function groupData(product) {
  if (product && product.features) {
    return (
      product.features &&
      product.features.reduce((acc, cur, idx, arr) => {
        var idx = acc.findIndex(
          (el) => JSON.stringify(el.data) === JSON.stringify(cur),
        );
        if (idx !== -1) {
          acc[idx].count++;
        } else {
          acc[acc.length] = {data: cur, count: 1};
        }
        return acc;
      }, [])
    );
  } else {
    return [];
  }
}