                  </Text>
                </Div>
                {/* Tax View */}
                <Div style={{ marginVertical: 15, marginHorizontal:10 }}>
                  <Div
                    style={{
                      display: 'flex',
                      flexDirection: 'row',
                      justifyContent: 'space-between',
                      marginBottom: 7,
                      // marginRight: 15,
                    }}>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
