export class AssignProductModal extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      isAddingGuest: false,
      selectedUser: [],
      guestContactCount: this.props.appointment.guests?.length > 1
      ? 0
      : this.props.appointment.guests?.length,
      // Highest guest number handed out from this sheet — a floor that keeps a
      // number spent even if the created record comes back unreadable.
      lastGuestNumber: 0,
      pendingGuestNumbers: [],
      roomTables: [],
      reservedSeats: [],
    };
  }

  componentDidMount = () => {
    this.setState({
      guestContactCount: this.props.appointment.guests
        ? parseInt(`${this.props.appointment.guests.length + 1}`, 10)
        : 1,
    });
    this.fetchSeatData();
  };

  fetchSeatData = () => {
    Axios.post('/businesses/api?query=getTablesForAssign')
      .then((res) => {
        this.setState({
          roomTables: res?.data?.tables?.rooms?.[0]?.tables || [],
          reservedSeats: Array.isArray(res?.data?.reservedSeats)
            ? res.data.reservedSeats
            : [],
        });
      })
      .catch((err) => {
        console.log('AssignProductModal getTablesForAssign error:', err);
      });
  };

  componentDidUpdate(prevProps, prevState) {
    if (
      JSON.stringify(prevProps.appointment.guests) !==
      JSON.stringify(this.props.appointment.guests)
    ) {
      this.setState({
        guestContactCount: this.props.appointment.guests
          ? parseInt(`${this.props.appointment.guests.length + 1}`, 10)
          : 1,
      });
    }
  }

  handleSelectedUsers = (id) => {
    const { selectedUser } = this.state;
    selectedUser.length > 0
      ? selectedUser.find((val) => val === id)
        ? this.setState({ selectedUser: selectedUser.filter((er) => er !== id) })
        : this.setState({ selectedUser: [...selectedUser, id] })
      : this.setState({ selectedUser: [...selectedUser, id] });
  };

  getInitial = (val) => {
    var initial = val?.charAt(0) != undefined && val?.charAt(0)?.toUpperCase();
    return initial;
  };

  handleSelectAll = (val) => {
    this.setState({ selectedUser: [] });
    if (val === 'selectall') {
      let a = this.props.usersList.map((er) => er._id);
      // Skip the unidentifiable records these sheets don't render — otherwise
      // Select All silently includes someone the operator can't see.
      let b = this.props.guestList
        .filter((er) => !this.isEmptyParticipant(er))
        .map((er) => er._id);
      let c = [...a, ...b];
      this.setState({ selectedUser: c });
    }
  };

  // NEWVYA-1134 — total seats of the appointment's ASSIGNED table(s).
  // room.tables may be a single object or an array; returns 0 when there's no
  // assigned table or no chairCount (so capacity checks no-op for legacy data).
  getAssignedTableSeats = (appt) => {
    const t = appt?.room?.tables;
    if (!t) return 0;
    const arr = Array.isArray(t) ? t : [t];
    return arr.reduce((sum, tbl) => sum + (parseFloat(tbl?.chairCount) || 0), 0);
  };

  // The guest number a record carries. Reads every field it can be numbered
  // by — including `recordID`, which survives when the display name doesn't.
  // Name-only scanning let a nameless record free its number for reuse.
  getGuestNumber = (user) => {
    const firstNameNumber = user?.firstName
      ? parseInt(`${user.firstName}`.replace(/Guest/i, '').trim(), 10)
      : NaN;
    const lastNameNumber = user?.lastName ? parseInt(`${user.lastName}`, 10) : NaN;

    if (!isNaN(firstNameNumber)) return firstNameNumber;
    if (!isNaN(lastNameNumber)) return lastNameNumber;

    const name = user?.username || user?.userName;
    const match = name ? `${name}`.match(/Guest\s*(\d+)/i) : null;
    if (match) return parseInt(match[1], 10);

    const recordNumber = parseInt(`${user?.recordID}`, 10);
    if (!isNaN(recordNumber)) return recordNumber;

    return NaN;
  };

  // What to print under the avatar. A record without a name used to render as
  // a blank — but still tappable — card; fall back to the number it carries.
  guestDisplayName = (user) => {
    const name = `${user?.username || user?.userName || ''}`.trim();
    if (name) return name;
    const num = this.getGuestNumber(user);
    return isNaN(num) ? '' : `Guest ${num}`;
  };

  // No name, no number, no products: identifies nobody and can't be assigned
  // to. Anything holding products is always rendered.
  isEmptyParticipant = (user) =>
    !this.guestDisplayName(user) && (user?.products?.length || 0) === 0;

  guestContact = (guestList) => {
    if (this.state.isAddingGuest) {
      return;
    }
    this.setState({isAddingGuest : true})
    const usedGuestNumbers = new Set();

    // Include pending guests that might not be in guestList yet
    const { guestContactCount } = this.state;

    // Read every entry — not just those flagged `guest` — across the caller's
    // list and the appointment prop, deduped by _id: either can be a beat
    // behind the server, and a stale list is what hands out a number twice.
    const seen = Object.create(null);
    [guestList, this.props.guestList, this.props.appointment?.guests].forEach((list) => {
      (list || []).forEach((user) => {
        const key = user?._id;
        if (key && seen[key]) return;
        if (key) seen[key] = true;
        const guestNumber = this.getGuestNumber(user);
        if (!isNaN(guestNumber)) usedGuestNumbers.add(guestNumber);
      });
    });

    const pending = this.state.pendingGuestNumbers || [];
    pending.forEach((n) => usedGuestNumbers.add(n));
    let nextGuestNumber = 1;
    while (usedGuestNumbers.has(nextGuestNumber)) nextGuestNumber++;

    const totalPersonsNow = (this.props.appointment?.products?.length || 0) + (this.props.appointment?.guests?.length || 0);
    const maxTablePersons = parseInt(this.props.appointment?.restaurant?.maxTablePersons, 10) || 10;
    if (totalPersonsNow >= maxTablePersons) {
      Toast.show(' Invite maximum persons for the resturant has been reached !!');
      this.setState({ isAddingGuest: false });
      return;
    }

    const _seatsFree = seatShortfallForAdd({
      appointment: this.props.appointment,
      tables: this.state.roomTables,
      reservedSeats: this.state.reservedSeats,
      nextTotal: totalPersonsNow + 1,
    });
    if (_seatsFree !== null) {
      const _area = `${this.props.appointment?.dining_area || 'Any'}`.toLowerCase();
      const _label =
        _area === 'indoor' ? 'Indoor' : _area === 'outdoor' ? 'Outdoor' : 'this restaurant';
      Toast.show(`Sorry, ${_label} has only ${_seatsFree} seats at this time !!`);
      this.setState({ isAddingGuest: false });
      return;
    }

    let guest = {
      userName: 'Guest' + ' ' + nextGuestNumber,
      firstName: 'Guest', // Add firstName
      lastName: nextGuestNumber.toString(), // Keep lastName as number string
      // recordID must be this guest's own number — it used to be the stale
      // guestContactCount, so it disagreed with the name and was useless as a
      // fallback when the name is missing.
      recordID: nextGuestNumber,
      type: 'guest',
    };

    // Update state immediately to prevent duplicate numbers on quick clicks
    this.setState({
      guestContactCount: nextGuestNumber,
      lastGuestNumber: nextGuestNumber,
      pendingGuestNumbers: [...(this.state.pendingGuestNumbers || []), nextGuestNumber],
    });

    Axios.post('/businesses/api?query=addGuestBusiness', {
      guest: guest,
      appointment: this.props.appointment._id,
    })
      .then(async (er) => {
        if (this.props.handleUser) {
          this.props.handleUser(er.data);
        } else if (this.props.updateAppointmentsData) {
          this.props.updateAppointmentsData(er.data);
        } else if (this.props._getInfo) {
          this.props._getInfo();
        }
        this.setState({ isAddingGuest: false });
      })
      .catch((error) => {
        console.log(error);
        this.setState({
          guestContactCount: guestContactCount,
          isAddingGuest: false,
          pendingGuestNumbers: (this.state.pendingGuestNumbers || []).filter(
            (n) => n !== nextGuestNumber,
          ),
        });
      });
  };

  render() {
    const { selectedUser, guestContactCount } = this.state;
    const { visible, onClose, usersList, guestList, assignProducts } = this.props;
    return (
      <ReactNativeModal
        visible={visible}
        aria-modal={true}
        style={{ backgroundColor: "rgba(0, 0, 0, 0.4)", margin: 0 }}
        onBackdropPress={() => {
          onClose();
        }}>
        <Div
          w={550}
          h={350}
          mx={'30%'} my={'30%'}
          rounded={43}
          p={30}
          bg='white'
        >
          <Text
            style={{
              fontSize: 21,
              fontFamily: Fonts.type.sfpSemiBold,
              color: '#000000',
              textAlign: 'center',
            }}>
            Assign to or split among…
          </Text>
          <Div aria-modal={true}>
            <ScrollView horizontal showsHorizontalScrollIndicator={false}>
              {usersList.map((er) => (
                <Div
                  py={12}
                  px={10}
                  mt={30}
                  mb={20}
                >
                  {selectedUser.some((val) => val === er._id) ? (
                    <TouchableOpacity
                      accessible={true}
                      accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                      onPress={() => this.handleSelectedUsers(er._id)}
                      style={{
                        position: 'absolute',
                        right: 7,
                        top: 5,
                        zIndex: 1000,
                      }}>
                      <Icon
                        name="closecircle"
                        color="black"
                        fontFamily="AntDesign"
                        fontSize="xl"
                      />
                    </TouchableOpacity>
                  ) : null}
                  <TouchableOpacity
                    accessible={true}
                    accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                    onPress={() => this.handleSelectedUsers(er._id)}>
                    <ParticipantAvatarName username={er.username} image={er.profile_image} />

                  </TouchableOpacity>
                </Div>
              ))}

              {guestList.map(
                (er) =>
                  !this.isEmptyParticipant(er) &&
                  (!er.payment_completed ||
                    (er.payment_completed && er.products.length == 0)) && (
                    <Div
                      py={12}
                      px={10}
                      mt={30}
                      mb={20}
                    >
                      {selectedUser.some((val) => val === er._id) ? (
                        <TouchableOpacity
                          accessible={true}
                          accessibilityLabel={(`${this.guestDisplayName(er)}close`).replace(/\s+/g, '')}
                          onPress={() => this.handleSelectedUsers(er._id)}
                          style={{
                            position: 'absolute',
                            right: 7,
                            top: 5,
                            zIndex: 1000,
                          }}>
                          <Icon
                            name="closecircle"
                            color="black"
                            fontFamily="AntDesign"
                            fontSize="xl"
                          />
                        </TouchableOpacity>
                      ) : null}
                      <TouchableOpacity
                        accessible={true}
                        accessibilityLabel={(`${this.guestDisplayName(er)}select`).replace(/\s+/g, '')}
                        onPress={() => this.handleSelectedUsers(er._id)}>
                        <ParticipantAvatarName username={this.guestDisplayName(er)} image={er.profile_image} />

                      </TouchableOpacity>
                    </Div>
                  ),
              )}
            </ScrollView>
          </Div>
          <Div row justifyContent="space-between">
            {selectedUser.length === usersList.length + guestList.length ? (
              <TouchableOpacity
                accessible={true}
                accessibilityLabel="unSelect"
                onPress={() => this.handleSelectAll('unselect')}>
                <Text style={{ color: Colors.active }}>Unselect</Text>
              </TouchableOpacity>
            ) : (
              <TouchableOpacity
                accessible={true}
                accessibilityLabel="selectAll"
                onPress={() => this.handleSelectAll('selectall')}>
                <Text style={{ color: Colors.active }}>Select All</Text>
              </TouchableOpacity>
            )}
            {this.props.appointment?.type !== 'pickup' && (
              <TouchableOpacity
                accessible={true}
                accessibilityLabel="addNewGuest"
                disabled={this.state.isAddingGuest}
                onPress={() => {
                  if (!this.state.isAddingGuest) {
                    this.guestContact(guestList);
                  }
                }}
              >
                <Text style={{ color: Colors.active }}>Add New Guest</Text>
              </TouchableOpacity>
            )}
          </Div>
          <Div flexDir='row' justifyContent='space-between'>
            <Button
              accessible={true}
              accessibilityLabel="assignProductsBtn"
              py={22}
              disabled={_.isEmpty(selectedUser)}
              px={90}
              bg={_.isEmpty(selectedUser) ? Colors.silver : Colors.active}
              rounded={16}
              onPress={() => {
                assignProducts(selectedUser, 'assign');
                this.setState({ selectedUser: [] });
              }}
              mt={28}
              shadow="md"
              borderless
              alignSelf="center">
              <Text
                style={{
                  fontSize: 17,
                  color: _.isEmpty(selectedUser) ? Colors.loblolly : Colors.snow,
                  fontFamily: Fonts.type.sfpSemiBold,
                }}>
                Assign
              </Text>
            </Button>
            <Button
              accessible={true}
              accessibilityLabel="assignProductsBtn"
              py={22}
              disabled={selectedUser?.length <= 1}
              px={90}
              bg={selectedUser?.length <= 1 ? Colors.silver : Colors.active}
              rounded={16}
              onPress={() => {
                assignProducts(selectedUser, 'split');
                this.setState({ selectedUser: [] });
              }}
              mt={28}
              shadow="md"
              borderless
              alignSelf="center">
              <Text
                style={{
                  fontSize: 17,
                  color: selectedUser?.length <= 1 ? Colors.loblolly : Colors.snow,
                  fontFamily: Fonts.type.sfpSemiBold,
                }}>
                Split
              </Text>
            </Button>
          </Div>
        </Div>
      </ReactNativeModal>
    );
  }
}

export class ChooseCustomSelection extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      selectedUser: '',
    };
  }

  render() {
    const {selectedUser} = this.state;
    const {visible, onClose, onApply, onChoose} = this.props;
    return (
      <Overlay
        w={320}
        // h={279}
        rounded={43}
        p={30}
        visible={visible !== ''}
        onBackdropPress={() => onClose()}>
        <Div justifyContent="center">
          <Text
            style={{
              textAlign: 'center',
              fontFamily: Fonts.type.sfpSemiBold,
              color: '#00000',
              fontSize: 15,
            }}>
            Apply the previous custom selection ?
          </Text>
        </Div>
        <Div
          style={{flexDirection: 'row', justifyContent: 'space-between'}}
          pt={20}>
          <Button bg={Colors.active} rounded={16} onPress={() => onChoose()}>
            <Text
              style={{
                fontFamily: Fonts.type.sfpSemiBold,
                // color: Colors.loblolly,
                color: Colors.silver,
              }}>
              No I'll Choose
            </Text>
          </Button>
          <Button bg={Colors.active} rounded={16} onPress={() => onApply()}>
            <Text
              style={{
                fontFamily: Fonts.type.sfpSemiBold,
                color: '#ffff',
              }}>
              Yes, Apply
            </Text>
          </Button>
        </Div>
      </Overlay>
    );
  }
}

export class AssignSplitProductModal extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      isAddingGuest: false,
      mainUser: '',
      selectedUser: [],
      guestContactCount: this.props.appointment.guests?.length > 1
      ? 0
      : this.props.appointment.guests?.length,
      // Highest guest number handed out from this sheet — a floor that keeps a
      // number spent even if the created record comes back unreadable.
      lastGuestNumber: 0,
      pendingGuestNumbers: [],
      roomTables: [],
      reservedSeats: [],
    };
  }

  componentDidMount = () => {
    this.setState({
      guestContactCount: this.props.appointment.guests
        ? parseInt(`${this.props.appointment.guests.length + 1}`, 10)
        : 1,
    });
    this.fetchSeatData();
  };

  fetchSeatData = () => {
    Axios.post('/businesses/api?query=getTablesForAssign')
      .then((res) => {
        this.setState({
          roomTables: res?.data?.tables?.rooms?.[0]?.tables || [],
          reservedSeats: Array.isArray(res?.data?.reservedSeats)
            ? res.data.reservedSeats
            : [],
        });
      })
      .catch((err) => {
        console.log('AssignSplitProductModal getTablesForAssign error:', err);
      });
  };

  componentDidUpdate(prevProps, prevState) {
    if (
      JSON.stringify(prevProps.appointment.guests) !==
      JSON.stringify(this.props.appointment.guests)
    ) {
      this.setState({
        guestContactCount: this.props.appointment.guests
          ? parseInt(`${this.props.appointment.guests.length + 1}`, 10)
          : 1,
      });
    }

    if(prevProps.splitedProd != this.props.splitedProd) {
      if(this.props.splitedProd.splited == true){
        this.setState({selectedUser: this.props.splitedProd.splitedTo});
      }
    }
  }

  handleSelectedUsers = (id) => {
    const {selectedUser} = this.state;
    selectedUser.length > 0
      ? selectedUser.find((val) => val === id)
        ? this.setState({selectedUser: selectedUser.filter((er) => er !== id)})
        : this.setState({selectedUser: [...selectedUser, id]})
      : this.setState({selectedUser: [...selectedUser, id]});
  };

  getInitial = (val) => {
    var initial = val?.charAt(0) != undefined && val?.charAt(0).toUpperCase();
    return initial;
  };

  handleSelectAll = (val) => {
    this.setState({ selectedUser: [] });
    if (val === 'selectall') {
      let a = this.props.usersList.map((er) => er._id);
      // Skip the unidentifiable records these sheets don't render — otherwise
      // Select All silently includes someone the operator can't see.
      let b = this.props.guestList
        .filter((er) => !this.isEmptyParticipant(er))
        .map((er) => er._id);
      let c = [...a, ...b];
      let filteredArray = c.filter((er) => {
        return er != this.props.splitedProd?.data?.userId;
      });
      this.setState({ selectedUser: filteredArray });
    }
  };

  handleSelectSplit = (val) => {
    this.setState({ selectedUser: [] });
    if (val === 'selectall') {
      let a = this.props.usersList.map((er) => er._id);
      // Skip the unidentifiable records these sheets don't render — otherwise
      // Select All silently includes someone the operator can't see.
      let b = this.props.guestList
        .filter((er) => !this.isEmptyParticipant(er))
        .map((er) => er._id);
      let c = [...a, ...b];
      this.setState({ selectedUser: c });
    }
  }

  // NEWVYA-1134 — total seats of the appointment's ASSIGNED table(s).
  // room.tables may be a single object or an array; returns 0 when there's no
  // assigned table or no chairCount (so the capacity check no-ops).
  getAssignedTableSeats = (appt) => {
    const t = appt?.room?.tables;
    if (!t) return 0;
    const arr = Array.isArray(t) ? t : [t];
    return arr.reduce((sum, tbl) => sum + (parseFloat(tbl?.chairCount) || 0), 0);
  };

  // The guest number a record carries. Reads every field it can be numbered
  // by — including `recordID`, which survives when the display name doesn't.
  // Name-only scanning let a nameless record free its number for reuse.
  getGuestNumber = (user) => {
    const firstNameNumber = user?.firstName
      ? parseInt(`${user.firstName}`.replace(/Guest/i, '').trim(), 10)
      : NaN;
    const lastNameNumber = user?.lastName ? parseInt(`${user.lastName}`, 10) : NaN;

    if (!isNaN(firstNameNumber)) return firstNameNumber;
    if (!isNaN(lastNameNumber)) return lastNameNumber;

    const name = user?.username || user?.userName;
    const match = name ? `${name}`.match(/Guest\s*(\d+)/i) : null;
    if (match) return parseInt(match[1], 10);

    const recordNumber = parseInt(`${user?.recordID}`, 10);
    if (!isNaN(recordNumber)) return recordNumber;

    return NaN;
  };

  // What to print under the avatar. A record without a name used to render as
  // a blank — but still tappable — card; fall back to the number it carries.
  guestDisplayName = (user) => {
    const name = `${user?.username || user?.userName || ''}`.trim();
    if (name) return name;
    const num = this.getGuestNumber(user);
    return isNaN(num) ? '' : `Guest ${num}`;
  };

  // No name, no number, no products: identifies nobody and can't be assigned
  // to. Anything holding products is always rendered.
  isEmptyParticipant = (user) =>
    !this.guestDisplayName(user) && (user?.products?.length || 0) === 0;

  guestContact = (guestList) => {
    if (this.state.isAddingGuest) {
      return;
    }
    this.setState({isAddingGuest : true})
    const usedGuestNumbers = new Set();

    // Include pending guests that might not be in guestList yet
    const { guestContactCount } = this.state;

    // Read every entry — not just those flagged `guest` — across the caller's
    // list and the appointment prop, deduped by _id: either can be a beat
    // behind the server, and a stale list is what hands out a number twice.
    const seen = Object.create(null);
    [guestList, this.props.guestList, this.props.appointment?.guests].forEach((list) => {
      (list || []).forEach((user) => {
        const key = user?._id;
        if (key && seen[key]) return;
        if (key) seen[key] = true;
        const guestNumber = this.getGuestNumber(user);
        if (!isNaN(guestNumber)) usedGuestNumbers.add(guestNumber);
      });
    });

    const pending = this.state.pendingGuestNumbers || [];
    pending.forEach((n) => usedGuestNumbers.add(n));
    let nextGuestNumber = 1;
    while (usedGuestNumbers.has(nextGuestNumber)) nextGuestNumber++;

    const totalPersonsNow2 = (this.props.appointment?.products?.length || 0) + (this.props.appointment?.guests?.length || 0);
    // Same `|| 10` fallback as the other add-guest sites — `n >= undefined` is
    // always false, so the cap did nothing when maxTablePersons was unset.
    const maxTablePersons2 = parseInt(this.props.appointment?.restaurant?.maxTablePersons, 10) || 10;
    if (totalPersonsNow2 >= maxTablePersons2) {
      Toast.show(' Invite maximum persons for the resturant has been reached !!');
      this.setState({ isAddingGuest: false });
      return;
    }

    const _seatsFree2 = seatShortfallForAdd({
      appointment: this.props.appointment,
      tables: this.state.roomTables,
      reservedSeats: this.state.reservedSeats,
      nextTotal: totalPersonsNow2 + 1,
    });
    if (_seatsFree2 !== null) {
      const _area2 = `${this.props.appointment?.dining_area || 'Any'}`.toLowerCase();
      const _label2 =
        _area2 === 'indoor' ? 'Indoor' : _area2 === 'outdoor' ? 'Outdoor' : 'this restaurant';
      Toast.show(`Sorry, ${_label2} has only ${_seatsFree2} seats at this time !!`);
      this.setState({ isAddingGuest: false });
      return;
    }

    let guest = {
      userName: 'Guest' + ' ' + nextGuestNumber,
      firstName: 'Guest', // Add firstName
      lastName: nextGuestNumber.toString(), // Keep lastName as number string
      // recordID must be this guest's own number — it used to be the stale
      // guestContactCount, so it disagreed with the name and was useless as a
      // fallback when the name is missing.
      recordID: nextGuestNumber,
      type: 'guest',
    };

    // Update state immediately to prevent duplicate numbers on quick clicks
    this.setState({
      guestContactCount: nextGuestNumber,
      lastGuestNumber: nextGuestNumber,
      pendingGuestNumbers: [...(this.state.pendingGuestNumbers || []), nextGuestNumber],
    });

    Axios.post('/businesses/api?query=addGuestBusiness', {
      guest: guest,
      appointment: this.props.appointment._id,
    })
      .then(async (er) => {
        if (this.props.handleUser) {
          this.props.handleUser(er.data);
        } else if (this.props._getInfo) {
          this.props._getInfo();
        }
        this.setState({ isAddingGuest: false });
      })
      .catch((error) => {
        console.log(error);
        this.setState({
          guestContactCount: guestContactCount,
          isAddingGuest: false,
          pendingGuestNumbers: (this.state.pendingGuestNumbers || []).filter(
            (n) => n !== nextGuestNumber,
          ),
        });
      });
  };
// here we change the based on multiple check this once this props multipleSplitedProd
  checkCondition = (a) => {
    const {selectedUser} = this.state;
    const {splitedProd, applyAssignProduct,guestList, applyMultipleSplit, multipleSplitedProd, personId, usersList } = this.props;
    let splitVerify = selectedUser?.length > 1 && selectedUser.some((e) => multipleSplitedProd.some((er) => er.userId === e) )
    let mainUserData = usersList.find((er) => er._id ==  personId)
    let mainGuestData = guestList.find((er) => er._id ==  personId)
    let hostUser = selectedUser?.includes(personId);
    let verifyUser = multipleSplitedProd.some((er) => personId == er.splitUser && !er.splitedTo.includes(personId))
    let serveProduct = multipleSplitedProd.find((er) => !er?.comp)
    const mainDataUser = mainUserData ? mainUserData : mainGuestData
    if(a === 'assign'){
      // showToast('Something Went Wrong...')
      if(hostUser){
        showToast('Cannot be assign self')
      } else if(verifyUser){
        showToast(`Cannot be assign to ${mainDataUser.username} product to others`)
      } else {
        applyAssignProduct(selectedUser, multipleSplitedProd),
        this.setState({selectedUser: []});
      }
    } else if(a === 'split'){
      if(splitVerify && multipleSplitedProd.some((er) => !er.splited)){
        const removeUser = selectedUser.filter((e) => {
          return !multipleSplitedProd.flatMap((er) => er?.userId).includes(e);
        });        
        applyMultipleSplit(removeUser),
        this.setState({selectedUser: []});
      } else if(selectedUser.some((e) => multipleSplitedProd.some((er) => er.userId === e && er.splited) )){
        showToast('Cannot be split splited products')
      } else if(!splitVerify) {
         showToast(`Cannot be split without ${mainDataUser.username}`)
        //  showToast(`{Cannot be split withoutdd`)
      }
    } else {
      showToast('Select the users')
    }
  }

  render() {
    const {selectedUser, guestContactCount} = this.state;
    const {visible, onClose, usersList, guestList,applySplit, splitedProd, splitMoveProduct, multipleSplitedProd} = this.props;
    return (
      <Overlay
        w={550}
        h={350}
        rounded={43}
        p={30}
        visible={visible}
        aria-modal={true}
        onBackdropPress={() => {
          this.setState({selectedUser: []});
          onClose();
        }}>
        <Text
          style={{
            fontSize: 21,
            fontFamily: Fonts.type.sfpSemiBold,
            color: '#000000',
            textAlign: 'center',
          }}>
          Assign to or split among…
        </Text>
          <Div aria-modal={true} style={styles.assignAvatarRowReserved}>
            <ScrollView horizontal showsHorizontalScrollIndicator={false}>
            {usersList.map((er) => (
              <>
                {splitMoveProduct ?
                  (
                    <Div py={12} px={10} mt={30} mb={20}>
                      {selectedUser.some((val) => val === er._id) ? (
                        <TouchableOpacity
                          accessible={true}
                          accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                          onPress={() => this.handleSelectedUsers(er._id)}
                          style={{
                            position: 'absolute',
                            right: 8,
                            top: 8,
                            zIndex: 1000,
                          }}>
                          <Icon
                            name="closecircle"
                            color="black"
                            fontFamily="AntDesign"
                            fontSize="xl"
                          />
                        </TouchableOpacity>
                      ) : null}
                      <TouchableOpacity
                        accessible={true}
                        accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                        onPress={() => this.handleSelectedUsers(er._id)}>
                        <ParticipantAvatarName username={er.username} image={er.profile_image} />
                      </TouchableOpacity>
                    </Div>
                  ) :
                  (er._id != splitedProd?.data?.userId && (
                    <Div py={12} px={10} mt={30} mb={20}>
                      {selectedUser.some((val) => val === er._id) ? (
                        <TouchableOpacity
                          accessible={true}
                          accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                          onPress={() => this.handleSelectedUsers(er._id)}
                          style={{
                            position: 'absolute',
                            right: 8,
                            top: 8,
                            zIndex: 1000,
                          }}>
                          <Icon
                            name="closecircle"
                            color="black"
                            fontFamily="AntDesign"
                            fontSize="xl"
                          />
                        </TouchableOpacity>
                      ) : null}
                      <TouchableOpacity
                        accessible={true}
                        accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                        onPress={() => this.handleSelectedUsers(er._id)}>
                        <ParticipantAvatarName username={er.username} image={er.profile_image} />
                      </TouchableOpacity>
                    </Div>
                  ))
                }
              </>
            ))}
            {guestList.map(
              (er) =>
                !this.isEmptyParticipant(er) &&
                (!er.payment_completed ||
                  (er.payment_completed && er.products.length == 0)) && (
                  <>
                    {splitMoveProduct ?
                      (<Div py={12} px={10} mt={30} mb={20}>
                        {selectedUser.some((val) => val === er._id) ? (
                          <TouchableOpacity
                            accessible={true}
                            accessibilityLabel={(`${this.guestDisplayName(er)}close`).replace(/\s+/g, '')}
                            onPress={() => this.handleSelectedUsers(er._id)}
                            style={{
                              position: 'absolute',
                              right: 8,
                              top: 8,
                              zIndex: 1000,
                            }}>
                            <Icon
                              name="closecircle"
                              color="black"
                              fontFamily="AntDesign"
                              fontSize="xl"
                            />
                          </TouchableOpacity>
                        ) : null}
                        <TouchableOpacity
                          accessible={true}
                          accessibilityLabel={(`${this.guestDisplayName(er)}select`).replace(/\s+/g, '')}
                          onPress={() => this.handleSelectedUsers(er._id)}>
                          <ParticipantAvatarName username={this.guestDisplayName(er)} image={er.profile_image} />
                        </TouchableOpacity>
                      </Div>
                      ) :
                      (er._id != splitedProd?.data?.userId && (
                        <Div py={12} px={10} mt={30} mb={20}>
                          {selectedUser.some((val) => val === er._id) ? (
                            <TouchableOpacity
                              accessible={true}
                              accessibilityLabel={(`${this.guestDisplayName(er)}close`).replace(/\s+/g, '')}
                              onPress={() => this.handleSelectedUsers(er._id)}
                              style={{
                                position: 'absolute',
                                right: 8,
                                top: 8,
                                zIndex: 1000,
                              }}>
                              <Icon
                                name="closecircle"
                                color="black"
                                fontFamily="AntDesign"
                                fontSize="xl"
                              />
                            </TouchableOpacity>
                          ) : null}
                          <TouchableOpacity
                            accessible={true}
                            accessibilityLabel={(`${this.guestDisplayName(er)}select`).replace(/\s+/g, '')}
                            onPress={() => this.handleSelectedUsers(er._id)}>
                            <ParticipantAvatarName username={this.guestDisplayName(er)} image={er.profile_image} />
                          </TouchableOpacity>
                        </Div>
                      ))
                    }
                  </>
                ),
            )}
            </ScrollView>
          </Div>
          <Div row justifyContent="space-between">
            {selectedUser.length === usersList.length + guestList.length ? (
              <TouchableOpacity 
                accessible={true}
                accessibilityLabel="unSelect"
                onPress={() => this.handleSelectAll('unselect')}>
                <Text style={{color: Colors.active}}>Unselect</Text>
              </TouchableOpacity>
            ) : (
              <TouchableOpacity
                accessible={true}
                accessibilityLabel="selectAll"
                onPress={() => {splitMoveProduct ? this.handleSelectSplit('selectall') : this.handleSelectAll('selectall')}}>
                <Text style={{color: Colors.active}}>Select All</Text>
              </TouchableOpacity>
            )}
            {this.props.appointment?.type !== 'pickup' && (
              <TouchableOpacity
                accessible={true}
                accessibilityLabel="addNewGuest"
                disabled={this.state.isAddingGuest}
                onPress={() => {
                  if (!this.state.isAddingGuest) {
                    this.guestContact(guestList);
                  }
                }}
              >
                <Text style={{color: Colors.active}}>Add New Guest</Text>
              </TouchableOpacity>
            )}
          </Div>
          {splitMoveProduct ? 
          <Div flexDir='row' justifyContent='space-between'>
          <Button
            accessible={true}
            accessibilityLabel="assignProductsBtn"
            py={22}
            disabled={selectedUser?.length !== 1}
            px={90}
            bg={selectedUser?.length !== 1 ? Colors.silver : Colors.active}
            rounded={16}
            onPress={() => this.checkCondition('assign')}
            mt={28}
            shadow="md"
            borderless
            alignSelf="center">
            <Text
              style={{
                fontSize: 17,
                color: selectedUser?.length !== 1  ? Colors.loblolly : Colors.snow,
                fontFamily: Fonts.type.sfpSemiBold,
              }}>
              Assign
            </Text>
          </Button>
          <Button
            accessible={true}
            accessibilityLabel="assignProductsBtn"
            py={22}
            disabled={selectedUser?.length <= 1}
            px={90}
            bg={selectedUser?.length <= 1   ? Colors.silver : Colors.active}
            rounded={16}
            onPress={() => this.checkCondition('split')}
            mt={28}
            shadow="md"
            borderless
            alignSelf="center">
            <Text
              style={{
                fontSize: 17,
                color: selectedUser?.length <= 1 ? Colors.loblolly : Colors.snow,
                fontFamily: Fonts.type.sfpSemiBold,
              }}>
              Split
            </Text>
          </Button>
          </Div>
          :
          <Button
            accessible={true}
            accessibilityLabel="assignProductsBtn"
            py={22}
            disabled={_.isEmpty(selectedUser)}
            px={162}
            bg={_.isEmpty(selectedUser) ? Colors.silver : Colors.active}
            rounded={16}
            onPress={() => {
              applySplit(selectedUser, splitedProd),
              this.setState({selectedUser: []});
            }}
            mt={28}
            shadow="md"
            borderless
            alignSelf="center">
            <Text
              style={{
                fontSize: 17,
                color: _.isEmpty(selectedUser) ? Colors.loblolly : Colors.snow,
                fontFamily: Fonts.type.sfpSemiBold,
              }}>
              Apply
            </Text>
          </Button>
          }
      </Overlay>
    );
  }
}

export const PrintPageModal = (props) => {
  const [selectedUser, setSelectedUser] = useState([]);
  const [options, setOptions] = useState('');

  useEffect(() => {
    setSelectedUser([]);
    setOptions('');
  },[props])

  const handleSelectedUsers = (id) => {
    setSelectedUser(prevSelectedUser => {
      if (prevSelectedUser.length > 0) {
        if (prevSelectedUser.find(val => val === id)) {
          return prevSelectedUser.filter(er => er !== id);
        } else {
          return [id];
        }
      } else {
        return [id];
      }
    });

  };


  const getInitial = (val) => {
    var initial = val?.charAt(0) != undefined && val?.charAt(0).toUpperCase();
    return initial;
  };

  const statusColor = (val) => {
    const checking = val.payment_completed;
    switch (checking) {
      case false:
        return Colors.tango;
      case true:
        return Colors.greenApple;
      default:
        return Colors.secondary;
    }
  }

const paymentMethod = (option,selectUser) => {
  if(option === 'event'){
    if(appointment.payment_completed){
      viewInvoice(option,appointment)
    }
    else{
      showToast('Payment Not Completed')
    }
  }
  else if(option === 'individual'){
    if(!_.isEmpty(selectUser)){
      viewInvoice(option, selectUser)
    }
    else{
      showToast('User Payment Not Completed')
    }
  }
  else{
    showToast('Payment Not Completed')
  }
}

  const {visible,onClose,usersList,guestList,appointment,viewInvoice} = props;
  return(
    <ReactNativeModal
      visible={visible}
      aria-modal={true}
      style={{ backgroundColor: "rgba(0, 0, 0, 0.4)", margin: 0 }}
      onBackdropPress={() => {
        onClose();
      }}>
      <Div
        w={550}
        h={650}
        mx={'30%'} my={'30%'}
        rounded={43}
        p={30}
        bg='white'
      >
        <Text
          style={{
            fontSize: 21,
            fontFamily: Fonts.type.sfpSemiBold,
            color: '#000000',
            textAlign: 'center',
          }}>
          Which invoice to Print ?
        </Text>

        <Div mt={20}>
        <Radio
          accessible={true}
          accessibilityLabel="eventInvoice"
          style={{ paddingBottom: '5%' }}
          onPress={() => setOptions('event')}
          checked={options == 'event' ? true : false}
          activeColor='#614577'
          suffix={
            <Text style={Styles.udpateTextContent}>
              Print the event's invoice
            </Text>
          } />
        <Radio
          accessible={true}
          accessibilityLabel="individualInvoice"
          style={{ paddingBottom: '5%' }}
          onPress={() => setOptions('individual')}
          checked={options == 'individual' ? true : false}
          activeColor='#614577'
          suffix={
            <Text style={Styles.udpateTextContent}>
              Print individual invoice of :
            </Text>
          } />
        </Div>

        <Div aria-modal={true}>
          <ScrollView horizontal showsHorizontalScrollIndicator={false}>
            {usersList.map((er) => (
              selectedUser.some((val) => val === er._id) && 
              <Div
                accessible={true}
                accessibilityLabel={(`${er.username}invoice`).replace(/\s+/g, '')}
                py={12}
                px={10}
                mt={30}
                mb={20}
              >
                  <TouchableOpacity
                    accessible={true}
                    accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                    onPress={() => handleSelectedUsers(er._id)}
                    style={{
                      position: 'absolute',
                      right: 8,
                      top: 8,
                      zIndex: 1000,
                    }}>
                    <Icon
                      name="closecircle"
                      color="black"
                      fontFamily="AntDesign"
                      fontSize="xl"
                    />
                  </TouchableOpacity>
                <TouchableOpacity
                  accessible={true}
                  accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                  onPress={() => handleSelectedUsers(er._id)}
                >
                  <ParticipantAvatarName username={er.username} image={er.profile_image} statusColor={statusColor(er)} />
                </TouchableOpacity>
              </Div>
            ))}
            {guestList.map(
              (er) => selectedUser.some((val) => val === er._id) && (
                  <Div
                    accessible={true}
                    accessibilityLabel={(`${er.username}invoice`).replace(/\s+/g, '')}
                    py={12}
                    px={10}
                    mt={30}
                    mb={20}
                  >
                      <TouchableOpacity
                        accessible={true}
                        accessibilityLabel={(`${er.username}close`).replace(/\s+/g, '')}
                        onPress={() => handleSelectedUsers(er._id)}
                        style={{
                          position: 'absolute',
                          right: 8,
                          top: 8,
                          zIndex: 1000,
                        }}>
                        <Icon
                          name="closecircle"
                          color="black"
                          fontFamily="AntDesign"
                          fontSize="xl"
                        />
                      </TouchableOpacity>
                    <TouchableOpacity
                      accessible={true}
                      accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                      onPress={() => handleSelectedUsers(er._id)}>
                      <ParticipantAvatarName username={er.username} image={er.profile_image} statusColor={statusColor(er)} />
                    </TouchableOpacity>
                  </Div>
                ),
            )}
          </ScrollView>
        </Div>

        <Divider/>

        <Div aria-modal={true}>
          <ScrollView horizontal showsHorizontalScrollIndicator={false}>
            {usersList.filter(er => er?.products?.length > 0).map((er) => (
              <Div
                py={12}
                px={10}
                mt={30}
                mb={20}
                opacity={er?.products?.length === 0 ? 0.6 : 1}
              >
                  <TouchableOpacity
                    disabled={er?.products?.length === 0}
                    accessible={true}
                  accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                  onPress={() => er.payment_completed && handleSelectedUsers(er._id)}
                  >
                    <ParticipantAvatarName username={er.username} image={er.profile_image} />
                  </TouchableOpacity>
                </Div>
            ))}
            {guestList.filter(er => er?.products?.length > 0).map(
              (er) =>
                <Div
                  py={12}
                  px={10}
                  mt={30}
                  mb={20}
                  opacity={er?.products?.length === 0 ? 0.6 : 1}
                >
                  <TouchableOpacity
                    disabled={er?.products?.length === 0}
                    accessible={true}
                      accessibilityLabel={(`${er.username}select`).replace(/\s+/g, '')}
                      onPress={() => er.payment_completed && handleSelectedUsers(er._id)}>
                    <ParticipantAvatarName username={er.username} image={er.profile_image} />
                  </TouchableOpacity>
                </Div>
            )}
          </ScrollView>
        </Div>
        <Button
          accessible={true}
          accessibilityLabel="assignProductsBtn"
          py={22}
          disabled={options === ''}
          px={162}
          bg={options == '' && selectedUser == '' ? Colors.silver : Colors.active}
          rounded={16}
          onPress={() => paymentMethod(options,selectedUser)}
          mt={28}
          shadow="md"
          borderless
          alignSelf="center">
          <Text
            style={{
              fontSize: 17,
              color: _.isEmpty(selectedUser) ? Colors.loblolly : Colors.snow,
              fontFamily: Fonts.type.sfpSemiBold,
            }}>
            Print Now
          </Text>
        </Button>
      </Div>
    </ReactNativeModal>
  )
}

export const InvoiceModal = (props) => {
  const [userProduct, setUserProduct] = useState([]);
  const { onClose, visible, guestList, usersList, appointment, singleInvoice, inline } = props;

  useEffect(() => {
    let userArray = [];
    usersList.map((person) => (
      userArray.push(person)
    ))
    guestList.map((person) => (
      userArray.push(person)
    ))
    setUserProduct(userArray);
  }, [props])

  // NEWVYA-1171: walk every per-bracket field on each line (multi-bracket lines, e.g. pizza 14% + arugula 3%, write to BOTH totalVAT14 and totalVAT3 on the same line).
  const paidForOtherTax = (type, person) => {
    const compFieldMap = {
      totalVAT3: 'compWithVAT3',          totalWithOutVAT3:  'compWithOutVAT3',
      totalVAT14: 'compWithVAT14',        totalWithOutVAT14: 'compWithOutVAT14',
      totalVAT17: 'compWithVAT17',        totalWithOutVAT17: 'compWithOutVAT17',
    };
    const compField = compFieldMap[type];
    let total = 0;
    person?.payed_for?.map((item) => {
      item.products.map((er) => {
        const value = er.comp ? (parseFloat(er[compField]) || 0) : (parseFloat(er[type]) || 0);
        total += value;
      })
    })
    return total;
  }
  // Reconciled VAT row for a bracket. ATI and VAT (= ATI - excl) stay the exact rounded
  // values (VAT stays correct, e.g. 0.33). Only when the three rounded parts don't sum
  // (a rare split+comp rounding artifact) do we plug the 1-cent gap into Excl so
  // Excl + VAT === ATI. Normal orders already reconcile, so it never fires for them.
  // On-premises-only per-bracket sum for THIS person: walk their lines, EXCLUDE preordered
  // ones (data.pre_ordered) — else the user-level person.totalVAT_N leaks the PREORDER
  // bracket into the On-Premises VAT rows (e.g. preorder pizza 3% = 12.80 shown on-prem
  // where there are no 3% items). Comp-aware, mirrors userVatTotal.
  const onPremBracket = (person, field) => {
    const compField = field.replace(/^totalWithOut/, 'compWithOut').replace(/^totalVAT/, 'compWithVAT');
    let sum = 0;
    (person?.products || []).forEach((line) => {
      if (line?.data?.pre_ordered) return;
      sum += parseFloat(line?.comp ? line?.[compField] : line?.[field]) || 0;
    });
    return sum;
  };
  const vatRow = (bracket, person) => {
    const round2 = (n) => Math.round(n * 100) / 100;
    const ati = onPremBracket(person, 'totalVAT' + bracket) + paidForOtherTax('totalVAT' + bracket, person);
    const excl = onPremBracket(person, 'totalWithOutVAT' + bracket) + paidForOtherTax('totalWithOutVAT' + bracket, person);
    // NEWVYA-1171: round ATI with toFixed to match c-app's ATI cell `(rawAti).toFixed(2)`.
    // On a .5 value (VAT3 0.2375+0.2375 = 0.475, ×100 = 47.5) Math.round gives 0.48
    // (half-up) but toFixed gives 0.47, so the bracket ATIs summed to 5.81 vs the 5.80
    // charged. Excl/VAT keep round2 (already match c-app).
    const showAti = Number(ati.toFixed(2));
    const showVat = round2(ati - excl);
    let showExcl = round2(excl);
    if (round2(showExcl + showVat) !== showAti) {
      showExcl = round2(showAti - showVat);
    }
    return { excl: showExcl.toFixed(2), vat: showVat.toFixed(2), ati: showAti.toFixed(2) };
  }
  const paidperProductsTotal = (paidUser) => {
    let paidTotal = 0;
    paidUser?.payed_for?.map((er) => {
      paidTotal = paidTotal + er?.finalTotal;
    })
    return paidTotal;
  }
  const getPersonPaidProds = (p) => {
    // NEWVYA-1171: render the "Paid for X" block from THIS payer's own payed_for[]
    // entries, which carry ONLY the items the payer actually covered (e.g. Roopa's
    // split Salamees). The old code looked up the paid-for person's FULL paid_products
    // record from appointment.paid_products, which also contains that person's OWN
    // preorder items (Roopa's 2 Margheritas, key=paid_products, pre_ordered=true) — a
    // preorder only the preordering user can pay — so the payer's invoice listed the
    // other user's preorder products (and the c-app/total had the matching leak).
    let finalP = (p.payed_for || []).filter((u) => (u.products || []).length > 0);

    // here
    return (
      <>
        {finalP.map((paidForUser) => (
          <Div px={8} py={4} style={{ marginTop: 15 }}>
            <Text style={styles.paidForStyles}>
            Paid for {paidForUser?.username?.split(/(?=[A-Z])/).join(' ')}
            </Text>

            {/* here */}
            {paidForUser?.products?.map((paidByMeProd) =>
              !paidByMeProd.splited && (
                <Div style={styles.foodItemContainer}
                  key={paidByMeProd?.id || paidByMeProd?.data?.id}
                >
             
                  <Div style={{ flex: 1, paddingRight: 10 }}>
                    <Text
                      style={
                        styles.paidForStyles2}
                    >
                       {paidByMeProd?.name != null
                    ? paidByMeProd?.name
                    : paidByMeProd?.data?.name}{' '}
                  x {paidByMeProd?.ordered_quantity}
                </Text>
                  </Div>
                  <Div style={{ minWidth: 60, alignItems: 'flex-end' }}>
                    <Text style={styles.paidForStyles}>
                      {`+ ${paidByMeProd?.totalPriceOfThis.toFixed(2)}€`}
                    </Text>
                  </Div>
                </Div>
              )
            )}

            {/* //here we need to check without split and comp */}
            {paidForUser?.products.some((e) => e.splited) && <Text style={styles.paidForStyles}>Split</Text>}
            {paidForUser?.products?.map((paidByMeProd) => (
              paidByMeProd?.splited &&
              <>
                <Div
                  style={
                    styles.foodItemContainer
                  }
                >
                  {/* Name + Quantity */}
                  <Div style={{ flex: 1, paddingRight: 10 }}>
                    <Text style={styles.paidForStyles2}>
                    {paidByMeProd?.name != null
                      ? paidByMeProd?.name
                      : paidByMeProd?.data?.name}{' '}
                    x{' '}
                    {paidByMeProd?.ordered_quantity +
                      '/' + parseInt(paidByMeProd?.splitedTo?.length + 1)}
                  </Text>
                  </Div>
                  <Div style={{ minWidth: 60, alignItems: 'flex-end' }}>
                    <Text style={styles.paidForStyles}>
                      {`+ ${paidByMeProd?.totalPriceOfThis.toFixed(2)}€`}
                    </Text>
                  </Div>
                </Div>

                {paidByMeProd?.comp && (
                  <Div row justifyContent="space-between" marginHorizontal={10}>
                    <Text color="#606060" fontSize={13}>{'\u2022'} Discount{'  '}{paidByMeProd.compDiscount}%</Text>
                    <Text color="#606060" fontSize={13}>-{(paidByMeProd.totalPriceOfThis - paidByMeProd.compTotal).toFixed(2)}€</Text>
                  </Div>
                )}

              </>
            ))}
          </Div>
        ))}
      </>
    );
  };
  const getTotalQtyPr = (item) => {
    // NEWVYA-1171: split-share price must show ATI (splitedTotalWithTax), not base (splitedTotalWithOutTax). Both fields already account for multi-bracket lines.
    // NEWVYA-1160: a COUPONED line must show the CHARGED price (totalPriceOfThis — the
    // server scales it and reconciles it to the billed total), matching c-app's invoice.
    // The invoice has no CouponDiscount row, so the old priceBeforeCoupon preference (and
    // the never-rescaled splitedTotalWithTax on split lines) made item lines not add up
    // to the Total/VAT rows (line 8.76€ vs charged 7.88€ on a 17.86€ invoice).
    const couponed = item?.lineBeforeCoupon != null ||
      (item?.priceBeforeCoupon !== undefined && item?.priceBeforeCoupon !== null);
    let amt = (couponed || !item?.splited)
      ? parseFloat(item.totalPriceOfThis)
      : parseFloat(item?.splitedTotalWithTax);
    // let tax = amt * (item?.data?.vat / 100);
    // amt = parseFloat(amt) + parseFloat(tax);

    // item?.features.map((et) => {
    //   et?.map((el) => {
    //     el?.items?.map((er) => {
    //       if (er?.selected === true && er?.price != undefined) {
    //         amt = parseFloat(amt) + parseFloat(er?.price);
    //       }
    //     });
    //   });
    // });
    return amt ? parseFloat(amt) : 0.00;
  };

  const userTotalTip = () => {
    let userTip = 0;
    userProduct.map((tip) => {
      if (tip.tip) {
        userTip = userTip + tip.tip
      }
    })
    return userTip.toFixed(2);
  }
  const userTotalDue = () => {
    // NEWVYA-1171: SUM due_amount across ALL users on the whole-invoice "Due" line.
    // The old code did `userDue = ... ? due.due_amount : 0`, which OVERWROTE userDue with
    // each user's value instead of adding — so a multi-user invoice showed only the LAST
    // user's due (e.g. two users owing 33.65 each showed 33.65, not 67.30). Now accumulate;
    // ignore sub-cent floating dust per line, and trim the trailing 1¢ dust on the total
    // (preserving the original threshold/-0.01 behaviour).
    const round2 = (n) => { const v = parseFloat(n); return Number.isFinite(v) ? Math.round(v * 100) / 100 : 0; };
    let userDue = 0;
    userProduct.map((due) => {
      const amt = round2(due?.due_amount);
      if (amt > 0) {
        userDue += amt;
      }
    })
    // round-half-up; the old `- 0.01` shaved a cent and UNDER-stated what's owed (the
    // restaurant lost money). With server-side amounts now rounded, no fudge is needed.
    return round2(userDue).toFixed(2);
  }
  // NEWVYA-1171: on-premise Total — sum only non-preordered lines per user (comp uses compTotal, else totalPriceOfThis).
  const userTotalBill = () => {
    let userTotal = 0;
    userProduct.forEach((person) => {
      (person?.products || []).forEach((line) => {
        if (line?.data?.pre_ordered) return;
        userTotal += parseFloat(line?.comp ? line?.compTotal : line?.totalPriceOfThis) || 0;
      });
    });
    return userTotal.toFixed(2);
  }
  // Single-person ON-PREMISE-ONLY total (comp-aware). Use instead of person.finalTotal for
  // the On-Premises Total — finalTotal bundles the PREORDER (shown separately above), so
  // finalTotal + paidFor double-counted it (99.76 vs the correct 88.43 the c-app shows).
  const personOnPremiseTotal = (person) => {
    let t = 0;
    (person?.products || []).forEach((line) => {
      if (line?.data?.pre_ordered) return;
      t += parseFloat(line?.comp ? line?.compTotal : line?.totalPriceOfThis) || 0;
    });
    return t;
  }
  //here we need to check other payment for whole invoice
  const userPayCard = (type) => {
    let userPaymentCard = 0;
    let userPaymentCash = 0;
    userProduct.map((pay) => {
      const paidBy = pay.payed_by != undefined
      const paidFor = pay.payed_for != undefined && pay.payed_for.length > 0 
      if(paidBy && paidFor){
        pay?.diffPaymentTypes?.map((er) => {
          if (er.type === 'Card' || er.type === 'credit-card') {
            userPaymentCard = userPaymentCard + er.amount
          }
          else if (er.type === 'cash') {
            userPaymentCash = userPaymentCash + er.amount
          }
        })
      } else if(paidBy && !paidFor && pay?.payed_by?.length == 0){
        pay?.diffPaymentTypes?.map((er) => {
          if (er.type === 'Card' || er.type === 'credit-card') {
            userPaymentCard = userPaymentCard + er.amount
          }
          else if (er.type === 'cash') {
            userPaymentCash = userPaymentCash + er.amount
          }
        })
      }
    })
    if (type === 'cash') {
      return userPaymentCash.toFixed(2)
    }
    else if (type === 'card') {
      return userPaymentCard.toFixed(2)
    }
    else {
      return 0;
    }
  }
  //here we need to check other payment for whole invoice     
  const userFoodVoucher = () => {
    let voucherAmount = 0
    // userProduct.map((er) => {
    //   er?.FoodVoucher?.vouchers?.map((el) => {
    //     voucherAmount = voucherAmount + (el?.amount * el?.count)
    //   })
    // })
    userProduct.map((pay) => {
      const paidBy = pay.payed_by != undefined
      const paidFor = pay.payed_for != undefined && pay.payed_for.length > 0 
      if(paidBy && paidFor){
        voucherAmount = voucherAmount + pay?.FoodVoucher?.totalVoucherAmount
      } else if(paidBy && !paidFor && pay?.payed_by?.length == 0){
        voucherAmount = voucherAmount + pay?.FoodVoucher?.totalVoucherAmount
      }
    })
    return voucherAmount.toFixed(2);
  }
  // NEWVYA-1171: on-premise VAT — walk only NON-preordered lines across users; comp uses compWith*.
  const userVatTotal = (vat) => {
    const buckets = { 3: { excl: 0, ati: 0 }, 14: { excl: 0, ati: 0 }, 17: { excl: 0, ati: 0 } };
    userProduct.forEach((person) => {
      (person?.products || []).forEach((line) => {
        if (line?.data?.pre_ordered) return;
        [3, 14, 17].forEach((b) => {
          const incKey  = line?.comp ? ('compWithVAT'    + b) : ('totalVAT'        + b);
          const baseKey = line?.comp ? ('compWithOutVAT' + b) : ('totalWithOutVAT' + b);
          buckets[b].ati  += parseFloat(line?.[incKey])  || 0;
          buckets[b].excl += parseFloat(line?.[baseKey]) || 0;
        });
      });
    });
    const vatAmt = (b) => buckets[b].ati - buckets[b].excl;
    if (vat === 'vat3tax')  return buckets[3].excl.toFixed(2);
    if (vat === 'vat3vat')  return vatAmt(3).toFixed(2);
    if (vat === 'vat3Ati')  return buckets[3].ati.toFixed(2);
    if (vat === 'vat14tax') return buckets[14].excl.toFixed(2);
    if (vat === 'vat14vat') return vatAmt(14).toFixed(2);
    if (vat === 'vat14Ati') return buckets[14].ati.toFixed(2);
    if (vat === 'vat17tax') return buckets[17].excl.toFixed(2);
    if (vat === 'vat17vat') return vatAmt(17).toFixed(2);
    if (vat === 'vat17Ati') return buckets[17].ati.toFixed(2);
  };

  // NEWVYA-1171: walk preordered_products[user].products[] per bracket (line-level is already coupon-scaled).
  const userPreVatTotal = (vat) => {
    const buckets = { 3: { excl: 0, ati: 0 }, 14: { excl: 0, ati: 0 }, 17: { excl: 0, ati: 0 } };
    userProduct.map((data) => {
      const person = data?.preordered_products?._id && data.firstName != 'Guest' && data?.preordered_products;
      if (!person?.products?.length) return;
      person.products.forEach((line) => {
        [3, 14, 17].forEach((b) => {
          const incKey  = line?.comp ? ('compWithVAT'    + b) : ('totalVAT'        + b);
          const baseKey = line?.comp ? ('compWithOutVAT' + b) : ('totalWithOutVAT' + b);
          buckets[b].ati  += parseFloat(line?.[incKey])  || 0;
          buckets[b].excl += parseFloat(line?.[baseKey]) || 0;
        });
      });
    });
    const vatAmt = (b) => buckets[b].ati - buckets[b].excl;
    if (vat === 'vat3tax')  return buckets[3].excl.toFixed(2);
    if (vat === 'vat3vat')  return vatAmt(3).toFixed(2);
    if (vat === 'vat3Ati')  return buckets[3].ati.toFixed(2);
    if (vat === 'vat14tax') return buckets[14].excl.toFixed(2);
    if (vat === 'vat14vat') return vatAmt(14).toFixed(2);
    if (vat === 'vat14Ati') return buckets[14].ati.toFixed(2);
    if (vat === 'vat17tax') return buckets[17].excl.toFixed(2);
    if (vat === 'vat17vat') return vatAmt(17).toFixed(2);
    if (vat === 'vat17Ati') return buckets[17].ati.toFixed(2);
  };
  let personPaidCompleteTime = appointment?.paid_products && appointment?.paid_products?.find((e) => {
    return appointment?.user_id?._id == e._id &&  e
  })
  let paidedTime = personPaidCompleteTime?.to_time ? personPaidCompleteTime?.to_time : personPaidCompleteTime?.updatedAt
  const updateData = [];
  const updatePreOrderData = [];
  const updateSplitData = [];
  const splitProductMap = new Map();

  const preOrderTime = appointment?.preordered_products?.map((person) => {
    if (singleInvoice == person._id) {
      return person?.preorderTime
    }
  }).filter(er => er != undefined);

  userProduct.forEach(person => {
    person.products.forEach(product => {
      if (product.splitId || product.splited) { 
        // Map ensures no duplicates
        splitProductMap.set(product.splitId, product);
      }
    });
  });
  updateSplitData.push(...splitProductMap.values());

  userProduct.map((person) => {
    updateData.push(...person.products)
  })
  userProduct.map((person) => {
    person?.preordered_products._id && updatePreOrderData.push(...person?.preordered_products?.products)
  })
  
  const userPreOrderTotal = (text) => {
    let PreTotal = 0;
    appointment.preordered_products.map((item) => {
      // NEWVYA-1171: derive coupon math from amountBeforeCoupon × (1 − discount%).
      const before = parseFloat(item?.amountBeforeCoupon);
      const discountPercent = parseFloat(item?.couponUsed?.discount);
      const hasCoupon = !!item?.couponUsed?._id;
      const discountAmount = hasCoupon && !isNaN(before) && !isNaN(discountPercent)
        ? (before * discountPercent) / 100
        : 0;
      const afterCoupon = hasCoupon && !isNaN(before)
        ? before - discountAmount
        : parseFloat(item?.finalTotal) || 0;
      if(text == 'discount'){
        if(hasCoupon){
        PreTotal += discountAmount
        }
      } else if(text == 'total'){
        PreTotal += hasCoupon ? before : (parseFloat(item?.finalTotal) || 0)
      } else if(text == 'card'){
        PreTotal += hasCoupon ? afterCoupon : (parseFloat(item?.finalTotal) || 0)
      }
    })
    return PreTotal.toFixed(2);
  }
  const onPremisesDatas = () => {
    return [...usersList, ...guestList].some(er =>
      er.products?.some(p => p.key != 'paid_products')
    );
  };
  // The invoice timestamp. Only ever built from times that are fixed when the
  // event happens. `updatedAt` is deliberately NOT used anywhere here: it tracks
  // the last edit of the record, so merely touching an old booking would restamp
  // its invoice with today's date — that is why a 28 Jul event was printing
  // "TODAY 13:20".
  //
  // Declared here, ABOVE personOrderList/singleInvoiceBill, on purpose: those are
  // consts holding JSX, so everything inside them is evaluated the moment they
  // are assigned. This used to sit ~740 lines further down, so personOrderList
  // read a hoisted `undefined`, and moment(undefined) silently returns "now" —
  // which stamped every History invoice with the current clock time.
  const paidEntryTime = (entry) => entry?.to_time;
  const paidProductsList = Array.isArray(appointment?.paid_products)
    ? appointment.paid_products
    : [];
  // Single-user invoice: that user's own settled entry.
  const matchedPaidEntry = paidProductsList.find((e) => singleInvoice == e._id);
  // Whole-event invoice (singleInvoice is '' or 'event', matching no _id): the
  // latest entry that actually carries a to_time. Entries without one are
  // skipped so they can't win the comparison via moment(undefined) === now.
  const datedPaidEntries = paidProductsList.filter((e) => paidEntryTime(e));
  const latestPaidEntry = datedPaidEntries.length
    ? datedPaidEntries.reduce((latest, e) =>
        moment(paidEntryTime(e)).isAfter(moment(paidEntryTime(latest)))
          ? e
          : latest,
      )
    : null;
  const paidTime =
    paidEntryTime(matchedPaidEntry) ||
    paidEntryTime(latestPaidEntry) ||
    appointment?.to_time ||
    appointment?.createdAt;
  // Keep saying TODAY for same-day invoices (the live Event screen), show the
  // real date for anything older (History).
  const invoiceDateLabel = moment(paidTime).isSame(moment(), 'day')
    ? 'TODAY'
    : moment(paidTime).format('DD MMM YYYY');

  const personOrderList = (
    <Div>
      <Div mx={10}>
        <Text>
          . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
          . . . . . . . . . . . . . . . . . . . . . . . . .
        </Text>
      </Div>
      {/* <Text style={{textAlign:'center', fontSize: 20, color:'red'}}>Whole Invoice</Text> */}

      <View
        style={{
          display: 'flex',
          marginHorizontal: 10,
          flexDirection: 'row',
          justifyContent: 'space-between',
        }}>
        <Text style={{ color: Colors.secondary }}>
          {invoiceDateLabel}</Text>
        <Text style={{ color: Colors.secondary }}>
          TYPE
        </Text>
        <Text style={{ color: Colors.secondary }}>
        PERSONS
        </Text>
      </View>

      <View
        style={{
          display: 'flex',
          flexDirection: 'row',
          marginHorizontal: 6,
          justifyContent: 'space-between',
          marginVertical: 4,
        }}>
        <>
          <Text style={styles.preOrderHeading}>
            {moment(paidTime).format('HH:mm',)}
          </Text>
        </>
        <Text style={styles.preOrderHeading}>
          RESERVATION
        </Text>
        <Text style={styles.preOrderHeading}>
         x {appointment?.products?.length + appointment?.guests?.length}
        </Text>
      </View>
      {updatePreOrderData.length > 0 &&
      <>
      <Text style={styles.preOrderHeading}>Pre-Order</Text>
          <>
              <Div pb={5}>
                <Div
                />
                {updatePreOrderData.length > 0 &&
                  updatePreOrderData.map((er) => (
                    <Div px={8} py={4}>
                      <Div row justifyContent="space-between">
                        <Div justifyContent="center">
                            <Text style={[styles.hostProductsStyles, {width: wp('22%')}]}>
                              {er.data.name} x {er.ordered_quantity}
                            </Text>
                        </Div>

                        <Div justifyContent="center">
                          <Text style={styles.hostProductsStyles}>
                            {getTotalQtyPr(er).toFixed(2)} €
                          </Text>
                        </Div>
                      </Div>

                      {er?.data?.features?.length > 0 &&
                        er?.data?.features.map((el, idx) => (
                          <>
                          {idx == 0 &&<Text style={{ color: '#A7ACB2', fontSize: 14 }}>Customization</Text>}
                          <Div row py={4}>
                            <Text style={styles.hostProductsStyles}>
                              {'\u2022'}
                            </Text>
                            <Text style={styles.hostProductsStyles}>
                              {el.header}:{' '}
                              {er?.features.map((feat, idx) =>
                                feat?.map((option) =>
                                  option?.items?.map((ite) =>
                                    el.header === option.header &&
                                      idx == 0 && ite.selected ? (
                                      <Text
                                        style={styles.hostProductsStyles}>
                                        {ite.name}
                                      </Text>
                                    ) : (
                                      <Text px={10}>{''}</Text>
                                    ),
                                  ),
                                ),
                              )}
                            </Text>
                          </Div>
                          </>
                        ))}
                            {/* Varietns & Modifiers */}
                            {er?.modifiersData && er?.modifiersData?.map((modifierGroup, idx) => (
                        modifierGroup?.modifiers?.map((modifier, mIdx) => (
                          modifier?.selected &&
                          <>
                            {idx == 0 && <Text style={{ color: '#A7ACB2', fontSize: 14 }}>Modifiers</Text>}
                            <View style={{ flexDirection: 'row' }}>
                              <Text style={styles.hostProductsStyles}>{'\u2022'} {modifierGroup?.modifierGroupName} : {modifier?.name}</Text>
                            </View>
                          </>
                        ))
                      ))}
                    </Div>
                  ))}
                <Div style={styles.dividerLine}></Div>
                <Div  py={15}>
                  <Div style={styles.foodItemContainer}>
                    <Text style={styles.preOrderTotal}>Total</Text>
                    <Text>{userPreOrderTotal('total')} €</Text>
                  </Div>
                  {userPreOrderTotal('discount') != 0 && (
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>
                          Discount
                        </Text>
                        <Text style={styles.hostProductsStyles}>
                        {userPreOrderTotal('discount')} €
                        </Text>
                      </Div>
                    )}
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>
                          EC-Card / Bank Card
                        </Text>
                        <Text style={styles.hostProductsStyles}>
                        {userPreOrderTotal('card')} €
                        </Text>
                      </Div>
                      {userPreOrderTotal('discount') != 0 && (<Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>
                          Total
                        </Text>
                        <Text style={styles.hostProductsStyles}>
                        {userPreOrderTotal('card')} €
                        </Text>
                      </Div>)}
                    </Div>
                    <Div marginHorizontal={4}>
                  <Text>
                    . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
                    . . . . . . . . . . . . . . . . . . . . . . . . . .
                  </Text>
                </Div>
                <Div marginHorizontal={10} marginTop={10}>
                  {/* VAT3% */}
                  {userPreVatTotal('vat3tax') != 0 && 
                  <Div
                    style={{
                      display: 'flex',
                      flexDirection: 'row',
                      justifyContent: 'space-between',
                      marginBottom: 7,
                    }}>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                      }}>
                      {'VAT 3% INCL. \t:'}
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 70,
                        textAlign: 'right',
                      }}>
                      {userPreVatTotal('vat3tax')}
                      €
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 50,
                        textAlign: 'right',
                      }}>
                      {userPreVatTotal('vat3vat')}
                      €
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 70,
                        textAlign: 'right',
                      }}>
                      {userPreVatTotal('vat3Ati')}
                      €
                    </Text>
                  </Div>}
                  {/* VAT14% */}
                  {userPreVatTotal('vat14tax') != 0 && 
                  <Div
                    style={{
                      display: 'flex',
                      flexDirection: 'row',
                      justifyContent: 'space-between',
