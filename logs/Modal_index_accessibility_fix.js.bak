export class CalendarView extends Component {
  render() {
    const {date, visible, _calendarView} = this.props;
    return (
      <Modal
        isVisible={visible}
        onBackdropPress={() => _calendarView()}
        onBackButtonPress={() => _calendarView()}
        style={{marginHorizontal: 0}}>
        <StatusBar
          backgroundColor="rgba(0, 0, 0, 0.2)"
          barStyle="light-content"
        />
        <View style={Styles.nativeV}>
          <Calendar
            disablePrevious={true}
            defaultDate={date}
            onChange={(e) => _calendarView(e.date)}
            // markedDates={[{ date: moment(date).format('DD-MM-YYYY') }]}
          />
          <View style={Styles.nativeSubV}>
            {' '}
            <FIicons
              name="close"
              size={wp(6)}
              color={Colors.secondary}
              onPress={() => _calendarView()}
            />{' '}
          </View>
        </View>
      </Modal>
    );
  }
}

export class TableView extends Component {
  constructor(props) {
    super(props);
    this.state = {
      radioKey: false,
      activeTbl: '',
      activeTblName: '',
      tableList: '',
      activeTblInfo: '',
    };
  }

  UNSAFE_componentWillMount = () => {
    Axios.post('/businesses/api?query=getRooms')
      .then((res) => {
        this.setState({tableList: res.data});
      })
      .catch((err) => {
        console.log(err);
      });
  };

  _assignTable = (activeTblInfo, radioKey) => {
    const {tableList} = this.state;
    const {appointment} = this.props;
    const assign = {
      appointment: appointment.id,
      room: {
        restaurantroomId: tableList.id,
        roomId: tableList.rooms[0].roomId,
        tables: [activeTblInfo],
      },
    };
    if (!radioKey && activeTblInfo) {
      Axios.post('/businesses/api?query=assignRoom', assign)
        .then((res) => {
          if (res) {
            this.props._tableView(res.data);
          }
        })
        .catch((errors) => {
          console.error(errors);
          this.props._tableView('');
        });
    } else {
      this.props._tableView('');
    }
  };

  render() {
    const {radioKey, activeTbl, activeTblName, tableList, activeTblInfo} =
      this.state;
    const {visible} = this.props;
    return (
      <Modal
        isVisible={visible}
        backdropOpacity={0.2}
        style={{margin: 0, justifyContent: 'flex-end'}}>
        <View style={Styles.cancelView}>
          <Handle />
          <View style={{marginHorizontal: wp('5%')}}>
            <Subheading>Please assign a table</Subheading>
            <View style={Styles.assignToScrollView}>
              <ScrollView horizontal showsHorizontalScrollIndicator={false}>
                {tableList
                  ? getTableAvlInfo(tableList.rooms[0].tables).map(
                      (el, idx) => (
                        <TouchableOpacity
                          key={idx}
                          style={
                            el.id != activeTbl || radioKey
                              ? Styles.assignToScrollViewChips
                              : [
                                  Styles.assignToScrollViewChips,
                                  {backgroundColor: '#eee'},
                                ]
                          }
                          onPress={() =>
                            this.setState({activeTblInfo: el, activeTbl: el.id})
                          }>
                          <Subheading
                            style={
                              el.id != activeTbl || radioKey
                                ? Styles.assignToScrollViewHeader
                                : [
                                    Styles.assignToScrollViewHeader,
                                    {color: Colors.active},
                                  ]
                            }>
                            {el.name}
                          </Subheading>
                        </TouchableOpacity>
                      ),
                    )
                  : [0, 1, 2, 3, 4, 5, 6].map((el, idx) => (
                      <Pressable
                        key={idx}
                        style={[
                          Styles.assignToScrollViewChips,
                          {backgroundColor: '#eee', width: 40},
                        ]}
                      />
                    ))}
              </ScrollView>
            </View>
            <View style={{marginVertical: wp('2%')}}>
              <TouchableOpacity
                style={Styles.radio}
                onPress={() => this.setState({radioKey: !radioKey})}>
                <View style={Styles.circle}>
                  {radioKey ? <View style={Styles.checkedCircle} /> : null}
                </View>
                <Subheading style={Styles.cancelHeading}>
                  Cancel table
                </Subheading>
              </TouchableOpacity>
            </View>
          </View>
          <View style={Styles.cancelButtonView}>
            <TouchableOpacity
              activeOpacity={1.0}
              style={[
                Styles.cancelButton,
                {
                  backgroundColor:
                    radioKey || activeTblInfo
                      ? Colors.active
                      : Colors.hiddenBtn,
                },
              ]}
              onPress={() =>
                radioKey || activeTblInfo
                  ? this._assignTable(activeTblInfo, radioKey)
                  : null
              }>
              <Text
                style={[
                  Styles.cancelButtonText,
                  {
                    color:
                      radioKey || activeTblInfo
                        ? Colors.white
                        : Colors.textGrey,
                  },
                ]}>
                {' '}
                Confirm{' '}
              </Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    );
  }
}

export class AssignTo extends Component {
  constructor(props) {
    super(props);
    this.state = {
      list: '',
    };
  }

  _snapTo = (id) => {
    this.setState((prevState) => {
      return {
        list: prevState.list != id ? id : '',
      };
    });
  };

  render() {
    const {list} = this.state;
    const {visible, appointment, _applySelectedNewProducts} = this.props;
    return (
      <Modal
        isVisible={visible}
        swipeDirection={'down'}
        onSwipeCancel={() => _applySelectedNewProducts('')}
        onBackButtonPress={() => _applySelectedNewProducts('')}
        backdropOpacity={0.2}
        style={{margin: 0, justifyContent: 'flex-end'}}>
        {/* <StatusBar backgroundColor="rgba(0, 0, 0, 0.2)" /> */}
        {/* <View style={Styles.assignV}> */}
        <View style={Styles.assignTo} aria-modal={true}>
          <Handle />
          <ScrollView showsVerticalScrollIndicator={false}>
            <View style={Styles.assignToSubView}>
              <Subheading style={Styles.assignToHeader}>
                {' '}
                Assign to or split among...
              </Subheading>
            </View>
            <View style={Styles.AgnChipsV}>
              <ScrollView horizontal showsHorizontalScrollIndicator={false}>
                {appointment &&
                  appointment.products &&
                  appointment.products.map((el, idx) => (
                    <TouchableOpacity
                      style={[
                        Styles.AgnScroollChipsV,
                        {
                          backgroundColor:
                            list === el._id ? Colors.darkView : Colors.white,
                        },
                      ]}
                      onPress={() => this._snapTo(el._id)}>
                      <Subheading
                        style={[
                          Styles.assignToScrollViewHeader,
                          {
                            color:
                              list === el._id ? Colors.active : Colors.black,
                          },
                        ]}>
                        {' '}
                        {el.username?.split(/(?=[A-Z])/).join(' ')}{' '}

                      </Subheading>
                    </TouchableOpacity>
                  ))}
              </ScrollView>
            </View>
          </ScrollView>
          <View style={{marginBottom: wp('8%'), marginHorizontal: wp('3%')}}>
            <TouchableOpacity
              style={Styles.assignBtn}
              onPress={() =>
                list
                  ? _applySelectedNewProducts(list)
                  : showToast('Select user to assign items !!')
              }>
              <Text style={Styles.assignTxt}>Apply</Text>
            </TouchableOpacity>
          </View>
        </View>
        {/* </View> */}
      </Modal>
    );
  }
}

export class OverViewModify extends Component {
  constructor(props) {
    super(props);
    this.state = {swapScreen: false, selectedIndex: 0};
  }

  handleIndexChange = (index) => {
    this.setState({...this.state, selectedIndex: index});
  };

  render() {
    const {visible, _overViewModify, item, overViewModifyKey} = this.props;
    const {swapScreen, selectedIndex} = this.state;
    return (
      <Modal
        isVisible={visible}
        style={{marginTop: '15%', margin: 0}}
        onBackButtonPress={() => _overViewModify()}>
        <StatusBar backgroundColor="rgba(0, 0, 0, 0.7)" />
        <View style={Styles.overVMdf}>
          <Handle />
          {!swapScreen ? (
            <ScrollView
              showsVerticalScrollIndicator={false}
              contentContainerStyle={{paddingHorizontal: wp('2%')}}>
              <View style={Styles.summary}>
                <View style={[Styles.summarySubView, Styles.flexRow]}>
                  <Subheading style={{fontSize: wp('3.5%')}}>
                    {' '}
                    Modify an order{' '}
                  </Subheading>
                </View>
              </View>
              {item.OverView.map((el, idx) => (
                <View style={Styles.summaryOverV}>
                  {el.NewOrderedListArr.map((el, idx) => (
                    <View key={idx}>
                      {' '}
                      <Subheading style={Styles.tableSubHeading}>
                        {' '}
                        {el.name}{' '}
                      </Subheading>
                      <View style={Styles.orderedItemsList}>
                        {' '}
                        {el.OrderedItemsList.map((el, idx) => (
                          <View key={idx}>
                            <Pressable
                              style={[
                                Styles.radio,
                                {justifyContent: 'space-between'},
                              ]}
                              key={idx}
                              onPress={() => _overViewModify(el.key)}>
                              <View style={Styles.radioSubView}>
                                <View style={Styles.circle}>
                                  {' '}
                                  {overViewModifyKey === el.key && (
                                    <View style={Styles.checkedCircle} />
                                  )}
                                </View>
                                <Subheading style={Styles.tableMutiSubHeading}>
                                  {el.name}
                                </Subheading>
                              </View>
                              <Subheading style={Styles.tableMutiSubHeading}>
                                {' '}
                                {el.amount}{' '}
                              </Subheading>
                            </Pressable>
                            <View style={Styles.subOrderedItemListView}>
                              {el.SubOrderedItemList.map((el, idx) => (
                                <View
                                  style={Styles.subOrderedItemList}
                                  key={idx}>
                                  <EIcon
                                    name="dot-single"
                                    size={15}
                                    color={Colors.textGrey}
                                  />
                                  <Subheading
                                    style={{
                                      fontSize: wp('2.5%'),
                                      color: Colors.textGrey,
                                    }}>
                                    {' '}
                                    {el.name} : {el.value}{' '}
                                  </Subheading>
                                </View>
                              ))}
                            </View>
                          </View>
                        ))}
                      </View>
                    </View>
                  ))}
                </View>
              ))}
            </ScrollView>
          ) : (
            <ScrollView
              showsVerticalScrollIndicator={false}
              contentContainerStyle={{paddingHorizontal: wp('3%')}}>
              <View style={Styles.summary}>
                <View style={[Styles.summarySubView, Styles.flexRow]}>
                  <Subheading style={{fontSize: wp('3.5%')}}>
                    {' '}
                    Please specify Void/Comp...{' '}
                  </Subheading>
                </View>
              </View>
              <View style={{margin: 15, alignSelf: 'center'}}>
                <SegmentedControl
                  tabs={['Void', 'Comp']}
                  currentIndex={selectedIndex}
                  onChange={this.handleIndexChange}
                  segmentedControlBackgroundColor={Colors.white}
                  activeSegmentBackgroundColor={Colors.active}
                  activeTextColor={Colors.white}
                  textColor={Colors.secondary}
                  paddingVertical={10}
                  width={wp(100) - 40}
                  containerStyle={{elevation: 2}}
                  textStyle={{fontSize: 13}}
                />
              </View>
              <View style={Styles.overVMdfCrdV}>
                {selectedIndex === 0 ? (
                  <View style={{padding: wp('4%')}}>
                    <Subheading style={{fontSize: wp('3.5%')}}>
                      Entry Error
                    </Subheading>
                    <Divider
                      style={{
                        backgroundColor: 'black',
                        marginVertical: wp('2%'),
                      }}
                    />
                    <Subheading style={{fontSize: wp('3.5%')}}>
                      Customer Changed Mind
                    </Subheading>
                  </View>
                ) : (
                  <View style={{padding: wp('4%')}}>
                    <Subheading style={{fontSize: wp('3.5%')}}>
                      Manager Discretion
                    </Subheading>
                    <Divider
                      style={{
                        backgroundColor: 'black',
                        marginVertical: wp('2%'),
                      }}
                    />
                    <Subheading style={{fontSize: wp('3.5%')}}>
                      Special Event Discount
                    </Subheading>
                    <Divider
                      style={{
                        backgroundColor: 'black',
                        marginVertical: wp('2%'),
                      }}
                    />
                    <Subheading style={{fontSize: wp('3.5%')}}>
                      {' '}
                      Birthday Discount
                    </Subheading>
                  </View>
                )}
              </View>
              <View>
                <TextInput
                  style={Styles.TextInputStyleClass}
                  underlineColorAndroid="transparent"
                  placeholder={'Add a note if other reason'}
                  placeholderTextColor={'#9E9E9E'}
                  numberOfLines={10}
                  multiline={true}
                />
              </View>
            </ScrollView>
          )}
          <View style={{marginBottom: wp('5%')}}>
            <TouchableOpacity
              activeOpacity={1.0}
              style={[
                Styles.cancelButton,
                {backgroundColor: !swapScreen ? '#F8F9F9' : Colors.active},
              ]}
              onPress={() => this.setState({swapScreen: true})}>
              <Text
                style={[
                  Styles.cancelButtonText,
                  {color: !swapScreen ? Colors.black : Colors.white},
                ]}>
                {!swapScreen ? 'VOID/COMP' : 'CONFIRM'}
              </Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    );
  }
}

export class Update extends Component {
  constructor(props) {
    super(props);
    this.state = {
      updateArray: [],
      radioKey: '',
      modalUpdate: false,
      accompagnement: '',
      cuisson: '',
      sauce: '',
      supplements: '',
      products: [],
    };
  }

  _snapTo = (item) => {
    this.setState((prevState) => {
      return {
        products: [...prevState.products, item],
      };
    });
  };

  _modal = () => {
    this.setState({modalUpdate: false});
  };

  _update = (accompagnement, cuisson, sauce, supplements) => {
    this.setState({
      modalUpdate: false,
      accompagnement: accompagnement,
      cuisson: cuisson,
      sauce: sauce,
      supplements: supplements,
    });
  };

  render() {
    const {item} = this.props;
    const {
      radioKey,
      modalUpdate,
      updateArray,
      accompagnement,
      cuisson,
      sauce,
      supplements,
      products,
    } = this.state;
    return (
      <View>
        <Modal
          isVisible={modalUpdate}
          onSwipeComplete={() => this.setState({modalUpdate: false})}
          onBackButtonPress={() => this.setState({modalUpdate: false})}
          backdropColor={'transparent'}
          style={{margin: 0}}>
          <View style={Styles.modalSubCartView}>
            <View style={Styles.modalSubCartScrollableModal}>
              <StatusBar backgroundColor={'rgba(0,0,0,0.5)'} />
              {updateArray || cuisson || sauce || supplements ? (
                <UpdateView
                  item={updateArray}
                  view={'Checkout'}
                  _modal={this._modal}
                  _update={this._update}
                />
              ) : null}
            </View>
          </View>
        </Modal>
        <Pressable style={Styles.radio} onPress={() => this._snapTo(item)}>
          <View style={Styles.circle}>
            {' '}
            {radioKey === item._id ? (
              <View style={Styles.checkedCircle} />
            ) : null}{' '}
          </View>
          <Subheading style={Styles.mutiModalSubHeading}>
            {' '}
            {item.name}{' '}
          </Subheading>
        </Pressable>
        {cuisson || sauce ? (
          <View style={{marginLeft: wp('5%')}}>
            <View style={{paddingHorizontal: wp('2%')}}>
              {accompagnement ? (
                <Text style={Styles.personaliserText}>
                  {' '}
                  + Accompagnement : {accompagnement}
                </Text>
              ) : null}
              {cuisson ? (
                <Text style={Styles.personaliserText}>
                  {' '}
                  + Cuisson : {cuisson}{' '}
                </Text>
              ) : null}
              {sauce ? (
                <Text style={Styles.personaliserText}>+ Sauce : {sauce}</Text>
              ) : null}
              {supplements ? (
                <Text style={Styles.personaliserText}>
                  {' '}
                  + Supplements : {supplements}{' '}
                </Text>
              ) : null}
            </View>
          </View>
        ) : null}
      </View>
    );
  }
}

export class NumberPad extends Component {
  constructor(props) {
    super(props);
    this.state = {amount: ''};
  }

  _keyDown = (key) => {
    this.setState({amount: key});
  };

  confirm = () => {
    const {amount} = this.state;
    const {_numberPad, type} = this.props;
    _numberPad(type, amount);
    setTimeout(() => {
      this.setState({amount: ''});
    }, 1000);
  };

  render() {
    const {visible, _numberPad, type} = this.props;
    const {amount} = this.state;
    return (
      <Modal
        isVisible={visible}
        style={{margin: 0}}
        onBackButtonPress={() => _numberPad(type)}
        backdropColor={'transparent'}
        animationIn={'zoomIn'}
        animationOut={'zoomOut'}>
        <StatusBar backgroundColor="rgba(0, 0, 0, 0.2)" />
        <View style={Styles.numberPad}>
          <View style={Styles.numberPadV}>
            <ScrollView showsVerticalScrollIndicator={false}>
              <View style={{marginBottom: wp('0%')}}>
                <TextInput
                  style={{
                    fontSize: wp('6%'),
                    textAlign: 'center',
                    color: Colors.active,
                  }}
                  underlineColorAndroid="transparent"
                  placeholder={'Amount'}
                  placeholderTextColor={Colors.textGrey}
                  value={amount}
                  onChangeText={(txt) => this.setState({amount: txt})}
                  editable={false}
                />
                <VirtualKeyboard
                  onRef={(ref) => (this.keyboard = ref)}
                  onChange={this._keyDown}
                  onCustomKey={this._keyDown}
                />
              </View>
            </ScrollView>
            <View style={{marginBottom: wp('5%')}}>
              <TouchableOpacity
                style={[
                  Styles.cancelButton,
                  {backgroundColor: !amount ? '#F8F9F9' : Colors.active},
                ]}
                onPress={() => this.confirm()}>
                <Text
                  style={[
                    Styles.cancelButtonText,
                    {color: !amount ? Colors.textGrey : Colors.white},
                  ]}>
                  {' '}
                  CONFIRM{' '}
                </Text>
              </TouchableOpacity>
            </View>
          </View>
        </View>
      </Modal>
    );
  }
}

export class FoodVoucher extends Component {
  constructor(props) {
    super(props);
    this.state = {
      amount: '',
      start: '',
      count: '',
      amountArr: [{amount: '10,80â‚¬'}, {amount: '8,40â‚¬'}],
    };
  }

  onChange(user, number, type) {
    console.warn(number);
  }

  confirm = (type, amount) => {
    const {_numberPad} = this.props;
    this._numberPad(type, amount);
    setTimeout(() => {
      this.setState({amount: ''});
    }, 1000);
  };

  render() {
    const {visible, _foodVoucher, type} = this.props;
    const {amount, amountArr, start} = this.state;
    return (
      <Modal
        isVisible={visible}
