                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 3, 'base').toFixed(2)}€
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 50,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 3, 'vat').toFixed(2)}€
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 3, 'ati').toFixed(2)}€
                      </Text>
                    </Div>
                  )}

                  {/* NEWVYA-1171: VAT14% computed from line-level. */}
                  {preorderBracketTotal(person?.preordered_products, 14, 'ati') != 0 && (
                    <Div
                      style={{
                        display: 'flex',
                        flexDirection: 'row',
                        justifyContent: 'space-between',
                        marginBottom: 7,
                        marginRight: 15,
                        marginLeft:5
                      }}>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                        }}>
                        {'VAT 14% INCL. \t:'}
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 14, 'base').toFixed(2)}€
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 50,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 14, 'vat').toFixed(2)}€
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {preorderBracketTotal(person?.preordered_products, 14, 'ati').toFixed(2)}€
                      </Text>
                    </Div>
                  )}

                  {/* VAT17% */}
                  {person?.preordered_products?.totalVAT17 != 0 && (
                    <Div
                      style={{
                        display: 'flex',
                        flexDirection: 'row',
                        justifyContent: 'space-between',
                        marginRight: 15,
                        marginLeft:5
                      }}>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          // color: Colors.secondary,
                          color: Colors.secondary,
                        }}>
                        {'VAT 17% INCL. \t:'}
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          // color: Colors.secondary,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {(person?.preordered_products?.totalWithOutVAT17).toFixed(2)}€
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          // color: Colors.secondary,
                          color: Colors.secondary,
                          width: 50,
                          textAlign: 'right',
                        }}>
                        {(
                          (person?.preordered_products?.totalVAT17) - (person?.preordered_products?.totalWithOutVAT17)
                        ).toFixed(2)}
                        €
                      </Text>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          // color: Colors.secondary,
                          color: Colors.secondary,
                          width: 70,
                          textAlign: 'right',
                        }}>
                        {(person?.preordered_products?.totalVAT17).toFixed(2)}€
                      </Text>
                    </Div>
                  )}
                </Div>
                <Div mx={10}>
                  <Text>
                    . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
                    . . . . . . . . . . . . . . . . . . . . . . . .
                  </Text>
                </Div>

              </Div>
            )}
          </>
        ))}
      </>}
      { onPremisesData() &&
      (<>
      <Text style={[styles.preOrderHeading, {marginHorizontal: 12}]}>On-Premises</Text>
      <View
        style={{
          display: 'flex',
          marginHorizontal: 12,
          flexDirection: 'row',
          justifyContent: 'space-between',
        }}>
        <Text style={{ color: Colors.secondary }}>
          DATE: {moment(paidTime).format('DD/MM/YYYY HH:mm',)}</Text>
        <Text style={{ color: Colors.secondary }}>
