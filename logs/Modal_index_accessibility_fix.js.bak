            €
          </Text>
          <Text
            style={{
              fontSize: 13,
              fontFamily: Fonts.type.sfpRegular,
              color: Colors.secondary,
              width: 70,
              textAlign: 'right',
            }}>
            {userVatTotal('vat17Ati')}€
          </Text>
        </Div>}
      </Div>

      <Div mx={10}>
        <Text>
          . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
          . . . . . . . . . . . . . . . . . . . . . . . .
        </Text>
      </Div>
      </>}
    </Div>
  );
  const discountCalculation = (data,obj, text) => {
    // NEWVYA-1171: derive coupon math from amountBeforeCoupon × (1 − discount%).
    const before = parseFloat(data?.amountBeforeCoupon);
    const pct = parseFloat(obj?.discount);
    if (!isNaN(before) && !isNaN(pct) && pct > 0) {
      const discountAmount = (before * pct) / 100;
      const after = before - discountAmount;
      return text == 'discount' ? discountAmount.toFixed(2) : after.toFixed(2);
    }
    const discountPercent = parseFloat(obj?.discount);
    const discountAmount = ((data?.userTotal) * discountPercent) / 100;
    const finalTotal = (data?.userTotal) - discountAmount;
    return text == 'discount' ? discountAmount.toFixed(2) : finalTotal.toFixed(2);
  }

  // NEWVYA-1171: sum per-bracket from preordered_products.products[] lines.
  // Line-level totalVAT_N is already coupon-scaled by server's applyCoupon fix; do NOT re-scale here.
  const preorderBracketTotal = (data, bracket, kind) => {
    if (!data?.products?.length) return 0;
    let inc = 0, base = 0;
    data.products.forEach((line) => {
      const incKey  = line?.comp ? ('compWithVAT'      + bracket) : ('totalVAT'        + bracket);
      const baseKey = line?.comp ? ('compWithOutVAT'   + bracket) : ('totalWithOutVAT' + bracket);
      inc  += parseFloat(line?.[incKey])  || 0;
      base += parseFloat(line?.[baseKey]) || 0;
    });
    if (kind === 'ati')  return inc;
    if (kind === 'base') return base;
    if (kind === 'vat')  return inc - base;
    return 0;
  };

  const onPremisesData = () => {
    return [...usersList, ...guestList].some(er =>
      er._id == singleInvoice &&
      er.products?.some(p => p.key != 'paid_products')
    );
  };
  const singleInvoiceBill = (
    <Div>
      <Div mx={10}>
        <Text>
          . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
          . . . . . . . . . . . . . . . . . . . . . . . .
        </Text>
      </Div>
      {/* <Text style={{textAlign:'center', fontSize: 20, color:'red'}}>singleInvoiceBill Invoice</Text> */}
      <View
        style={{
          display: 'flex',
          marginHorizontal: 10,
          flexDirection: 'row',
          justifyContent: 'space-between',
        }}>
        <Text style={{ color: Colors.secondary }}>
          {invoiceDateLabel}</Text>
        <Text style={{ color: Colors.secondary }}>
          TYPE
        </Text>
        <Text style={{ color: Colors.secondary }}>
        PERSONS
        </Text>
      </View>

      <View
        style={{
          display: 'flex',
          flexDirection: 'row',
          marginHorizontal: 10,
          justifyContent: 'space-between',
          marginVertical: 4,
        }}>
        <>
          <Text style={styles.preOrderHeading}>
            {moment(paidTime).format('HH:mm',)}
          </Text>
        </>
        <Text style={styles.preOrderHeading}>
          RESERVATION
        </Text>
        <Text style={styles.preOrderHeading}>
         x {appointment?.products?.length + appointment?.guests?.length}
        </Text>
      </View>
      {appointment?.preordered_products?.length > 0 && appointment?.preordered_products?.some((e) => singleInvoice == e._id) &&
      <>
      <Text style={styles.preOrderHeading}>Pre-Order</Text>
      <View
        style={{
          display: 'flex',
          marginHorizontal: 10,
          flexDirection: 'row',
          justifyContent: 'space-between',
        }}>
        <Text style={{ color: Colors.secondary }}>
          DATE: {moment(preOrderTime[0]).format('DD/MM/YYYY HH:mm',)}</Text>
        <Text style={{ color: Colors.secondary }}>
          INVOICE:  {appointment.ticketId}
        </Text>
      </View>

      <View
        style={{
          display: 'flex',
          flexDirection: 'row',
          marginHorizontal: 10,
          justifyContent: 'space-between',
          marginVertical: 4,
        }}>
        <>
          <Text style={{ color: Colors.secondary }}>
            PERSONS: x {appointment?.products?.length + appointment?.guests?.length}
          </Text>
        </>
        <Text
          style={{ color: Colors.secondary }}>
          TICKET: {appointment.ticketId}
        </Text>
      </View>

      {usersList.length > 0 &&
        usersList.map((person, idx) => (
          <>
            {person.show_invoice && singleInvoice == person._id && (
              <Div pt={10} pb={15} px={5}>
                <Div
                  py={10}
                  // borderTopWidth={0.5}
                  // borderColor={Colors.borderBlack}
                />
                {person?.preordered_products?._id && person?.preordered_products.products.length > 0 &&
                  person?.preordered_products?.products[0].features.length > 0
                  ? person?.preordered_products.products?.map((er) => (
                    // ? person?.products.map((er) => er?.key != 'paid_products' && (
                    // er.key != 'paid_products' &&
                    // preordered_products

                    <Div px={8} py={4}>
                      <Div row justifyContent="space-between">
                        <Div justifyContent="center">
                          {er?.splited  ? (
                            <Text style={[styles.hostProductsStyles, {width: wp('22%')}]}>
                              {er.data.name} x{' '}
                              {er.ordered_quantity +
                                '/' + parseInt(er.splitedTo.length + 1)}
                            </Text>
                          ) : (
                            <Text style={[styles.hostProductsStyles, {width: wp('22%')}]}>
                              {er.data.name} x {er.ordered_quantity}
                            </Text>
                          )}
                        </Div>

                        <Div justifyContent="center">
                          <Text style={styles.hostProductsStyles}>
                            {getTotalQtyPr(er).toFixed(2)} €
                          </Text>
                        </Div>
                      </Div>

                      {er?.data?.features?.length > 0 &&
                        er?.data?.features.map((el, idx) => (
                          <>
                          {idx == 0 &&<Text style={{ color: '#A7ACB2', fontSize: 14 }}>Customization</Text>}
                          <Div row py={4}>
                            <Text style={styles.hostProductsStyles}>
                              {'\u2022'}
                            </Text>
                            <Text style={styles.hostProductsStyles}>
                              {el.header}:{' '}
                              {er?.features.map((feat, idx) =>
                                feat?.map((option) =>
                                  option?.items?.map((ite) =>
                                    el.header === option.header &&
                                      idx == 0 && ite.selected ? (
                                      <Text
                                        style={styles.hostProductsStyles}>
                                        {ite.name}
                                      </Text>
                                    ) : (
                                      <Text px={10}>{''}</Text>
                                    ),
                                  ),
                                ),
                              )}
                            </Text>
                          </Div>
                          </>
                        ))}
                            {/* Varietns & Modifiers */}
                            {er?.modifiersData && er?.modifiersData?.map((modifierGroup, idx) => (
                        modifierGroup?.modifiers?.map((modifier, mIdx) => (
                          modifier?.selected &&
                          <>
                            {idx == 0 && <Text style={{ color: '#A7ACB2', fontSize: 14 }}>Modifiers</Text>}
                            <View style={{ flexDirection: 'row' }}>
                              <Text style={styles.hostProductsStyles}>{'\u2022'} {modifierGroup?.modifierGroupName} : {modifier?.name}</Text>
                            </View>
                          </>
                        ))
                      ))}
                    </Div>
                  ))
                  : null}

                <Div style={styles.dividerLine}></Div>
                {/* Total View */}
                <Div py={15}>
                  <Div style={styles.foodItemContainer}>
                  {/* style={styles.preOrderHeading} */}
                    <Text style={styles.preOrderTotal}>Total</Text>
                    {/* NEWVYA-1171: when a coupon is active, Total must show pre-coupon amount; coupon-line below shows the discount. */}
                    <Text style={styles.preOrderTotal}>{(person?.preordered_products?.couponUsed?._id && person?.preordered_products?.amountBeforeCoupon ? parseFloat(person.preordered_products.amountBeforeCoupon) : (parseFloat(person?.preordered_products?.finalTotal) || 0)).toFixed(2)} €</Text>
                  </Div>

                  {person?.preordered_products?.couponUsed?._id
                      && (
                        <Div style={styles.foodItemContainer}>
                          <Text style={styles.hostProductsStyles}>
                            Discount
                          </Text>
                          <Text style={styles.hostProductsStyles}>
                          {`${discountCalculation(person?.preordered_products, person?.preordered_products?.couponUsed, 'discount')}€`}
                          </Text>
                        </Div>
                      )}

                  {person?.preordered_products?.payment_type === 'Card' ? (
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>
                          EC-Card / Bank Card
                        </Text>
                        <Text style={styles.hostProductsStyles}>
                          {person?.preordered_products?.couponUsed ? discountCalculation(person?.preordered_products, person?.preordered_products?.couponUsed) : person?.preordered_products?.userTotal.toFixed(2)}€
                        </Text>
                      </Div>
                    ) : null}
                  {person?.preordered_products?.couponUsed?._id ? (
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>
                          Total
                        </Text>
                        <Text style={styles.hostProductsStyles}>
                          {person?.preordered_products?.couponUsed ? discountCalculation(person?.preordered_products, person?.preordered_products?.couponUsed) : person?.preordered_products?.userTotal.toFixed(2)}€
                        </Text>
                      </Div>
                    ) : null}

                </Div>
                <Div mx={10}>
                  <Text>
                    . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
                    . . . . . . . . . . . . . . . . . . . . . . . .
                  </Text>
                </Div>
                {/* Tax View */}
                <Div style={{ marginVertical: 15, marginLeft: 10 }}>
                  <Div
                    style={{
                      display: 'flex',
                      flexDirection: 'row',
                      justifyContent: 'space-between',
                      marginBottom: 7,
                      marginRight: 15,
                    }}>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                      }}>
                      {'\t\t\t\t '}
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 70,
                        textAlign: 'right',
                      }}>
                      Excl. Tax
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 50,
                        textAlign: 'right',
                      }}>
                      VAT
                    </Text>
                    <Text
                      style={{
                        fontSize: 13,
                        fontFamily: Fonts.type.sfpRegular,
                        color: Colors.secondary,
                        width: 70,
                        textAlign: 'right',
                      }}>
                      ATI
                    </Text>
                  </Div>

                  {/* NEWVYA-1171: VAT3% computed from line-level so multi-bracket (e.g. arugula 3% on pizza 14%) shows. */}
                  {preorderBracketTotal(person?.preordered_products, 3, 'ati') != 0 && (
                    <Div
                      style={{
                        display: 'flex',
                        flexDirection: 'row',
                        justifyContent: 'space-between',
                        marginBottom: 7,
                        marginRight: 14,
                        marginLeft:5
                      }}>
                      <Text
                        style={{
                          fontSize: 13,
                          fontFamily: Fonts.type.sfpRegular,
                          color: Colors.secondary,
                        }}>
