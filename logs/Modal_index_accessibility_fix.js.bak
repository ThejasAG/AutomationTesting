                          {pt.amount.toFixed(2)}€
                        </Text>
                      </Div>
                    ) : pt.type === 'cash' ? (
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>Cash </Text>
                        <Text style={styles.hostProductsStyles}>
                          {pt.amount.toFixed(2)}€
                        </Text>
                      </Div>
                    ) : null,
                  )}

                </Div>
                <Div mx={10}>
                  <Text>
