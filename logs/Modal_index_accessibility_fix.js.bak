                    accessibilityLabel={`tableChip${el.name}`}
                    accessibilityState={{selected: activeTables.includes(el.name)}}
                    style={
                      !activeTables.includes(el.name)
                        ? Styles.assignToScrollViewChips
                        : [
                            Styles.assignToScrollViewChips,
                            {backgroundColor: '#eee'},
                          ]
                    }
                    onPress={() => this.updatingtables(el.name)}>
                    <Subheading
                      style={
                        !activeTables.includes(el.name)
