                <TextInput
                  style={{
                    fontSize: wp('6%'),
                    textAlign: 'center',
                    color: Colors.active,
                  }}
                  underlineColorAndroid="transparent"
                  placeholder={'Amount'}
                  placeholderTextColor={Colors.textGrey}
                  value={amount}
                  onChangeText={(txt) => this.setState({amount: txt})}
