        rooms: this.props.rooms?.tables?.rooms ?? [],
      });
    }
  }

  updatingtables = (data) => {
    let updateData = [...this.state.activeTables]; // Create a copy of the current activeTables
    if (updateData.includes(data)) {
        // If data exists, remove it
        updateData = updateData.filter(item => item !== data);
    } else {
        // If data doesn't exist, add it
        updateData.push(data);
    }
    this.setState({ activeTables: updateData });    
