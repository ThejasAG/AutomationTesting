                />
                {amountArr.map((el, idx) => (
                  <View key={idx} style={Styles.payAmountList}>
                    <Text style={{fontSize: wp('6%')}}>{el.amount}</Text>
                    <Counter
                      min={0}
                      max={10}
                      buttonStyle={Styles.resSubHeaderSegSubVSubCuntBt}
                      buttonTextStyle={Styles.resSubHeaderSegSubVSubCuntBtTxt}
                      countTextStyle={{color: Colors.black}}
                      onChange={this.onChange.bind(this)}
                    />
                  </View>
                ))}
              </View>
            </ScrollView>
            <View style={{marginBottom: wp('5%')}}>
              <TouchableOpacity
                style={[Styles.cancelButton, {backgroundColor: Colors.active}]}
                onPress={() => _foodVoucher(type, amount)}>
                <Text style={[Styles.cancelButtonText, {color: Colors.white}]}>
                  {' '}
                  CONFIRM{' '}
                </Text>
              </TouchableOpacity>
            </View>
          </View>
        </View>
      </Modal>
    );
  }
}

export class Filter extends Component {
  constructor(props) {
    super(props);
    this.state = {
      filterOptions: [
        {name: 'Reserved'},
        {name: 'In Progress'},
        {name: 'Order'},
        {name: 'Serve'},
        {name: 'Payment Notified'},
        {name: 'Payment Completed'},
      ],
      name: '',
    };
  }

  changeName = () => {
    this.setState({name : ''})
  }

  render() {
    const {visible, filterFun, closeFilter} = this.props;
    const {filterOptions, name} = this.state;
    return (
      <Overlay
        w={550}
        h={520}
        rounded={43}
        visible={visible}
        onBackdropPress={() => closeFilter()}>
        <View style={{marginHorizontal: wp('3%')}}>
          <Subheading
            style={{
              fontSize: 21,
              textAlign: 'center',
              color: '#000000',
              paddingTop: 20,
            }}>
            Filter By
          </Subheading>
          <View style={{marginVertical: 30}}>
            {filterOptions.map((el, idx) => (
              <Pressable
                key={idx}
                style={Styles.flexRow}
                onPress={() => this.setState({name: el.name})}>
                <View style={Styles.circle}>
                  {name === el.name && <View style={Styles.checkedCircle} />}
                </View>
                <View style={{marginVertical: 15, marginHorizontal: 12}}>
                  <Text style={Styles.filterText}>{el.name}</Text>
                </View>
              </Pressable>
            ))}
          </View>
        </View>
        <View
          style={{
            justifyContent: 'center',
            alignItems: 'center',
            marginBottom: 30,
          }}>
          <Pressable
            style={[Styles.cancelButton, {backgroundColor: Colors.active}]}
            onPress={() => {filterFun(name); this.changeName()}}>
            <Text style={[Styles.cancelButtonText, {color: Colors.white}]}>
              {' '}
              Apply{' '}
            </Text>
          </Pressable>
        </View>
      </Overlay>
    );
  }
}

