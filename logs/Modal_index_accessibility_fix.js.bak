                        </Div>

                        <Div justifyContent="center">
                          <Text style={styles.hostProductsStyles}>
                            {getTotalQtyPr(er).toFixed(2)} €
                          </Text>
                        </Div>
                      </Div>

                      {er?.data?.features?.length > 0 &&
                        er?.data?.features.map((el, idx) => (
                          <>
                          {idx == 0 &&<Text style={{ color: '#A7ACB2', fontSize: 14 }}>Customization</Text>}
                          <Div row py={4}>
                            <Text style={styles.hostProductsStyles}>
                              {'\u2022'}
                            </Text>
                            <Text style={styles.hostProductsStyles}>
                              {el.header}:{' '}
                              {er?.features.map((feat, idx) =>
                                feat?.map((option) =>
                                  option?.items?.map((ite) =>
                                    el.header === option.header &&
                                      idx == 0 && ite.selected ? (
                                      <Text
                                        style={styles.hostProductsStyles}>
                                        {ite.name}
                                      </Text>
                                    ) : (
                                      <Text px={10}>{''}</Text>
                                    ),
                                  ),
                                ),
                              )}
                            </Text>
                          </Div>
                          </>
                        ))}
                            {/* Varietns & Modifiers */}
                            {er?.modifiersData && er?.modifiersData?.map((modifierGroup, idx) => (
                        modifierGroup?.modifiers?.map((modifier, mIdx) => (
                          modifier?.selected &&
                          <>
                            {idx == 0 && <Text style={{ color: '#A7ACB2', fontSize: 14 }}>Modifiers</Text>}
                            <View style={{ flexDirection: 'row' }}>
                              <Text style={styles.hostProductsStyles}>{'\u2022'} {modifierGroup?.modifierGroupName} : {modifier?.name}</Text>
                            </View>
                          </>
                        ))
                      ))}
                    </Div>
                  )))
                  : null}

                {/* paid for View */}
                {getPersonPaidProds(person)}

                {/* paid by View */}
                {person && person.payed_by && person.payed_by.username && (
                  <Div py={4} style={styles.foodItemContainer}>
                    <Text style={styles.paidForStyles}>
                    Paid by {person.payed_by.username.split(/(?=[A-Z])/).join(' ')}
                    </Text>
                    <Text style={styles.paidForStyles}>
                      {`- ${person?.finalTotal?.toFixed(2)}€`}
                    </Text>
                  </Div>
                )}

                {/* Overall Total View */}
                <Div style={styles.overAllTotalContainer}>
                  <Text>Tip</Text>
                  <Text style={{ color: Colors.textGrey }}>
                    {person && person.tip ? person.tip.toFixed(2) : 0.0}€
                  </Text>
                </Div>
                <Div my={15}>

                  <Div style={styles.overAllTotalContainer}>
                    <Text style={{ color: Colors.textGrey }}>Outstanding</Text>
                    <Text style={{ color: Colors.textGrey }}>
                      {person && person.outstanding_amount
                        ? person.outstanding_amount.toFixed(2)
                        : 0.0}
                      €
                    </Text>
                  </Div>

                  <Div style={styles.overAllTotalContainer}>
                    <Text>Due</Text>
                    <Text style={{ color: Colors.textGrey }}>
                      {person && (Math.round((parseFloat(person.due_amount)||0)*100)/100) > 0
                        ? (Math.round((parseFloat(person.due_amount)||0)*100)/100).toFixed(2)
                        : 0.0}
                      €
                    </Text>
                  </Div>
                </Div>

                <Div style={styles.dividerLine}></Div>
                {/* Total View */}
                <Div py={15}>
                  <Div style={styles.foodItemContainer}>
                    <Text style={styles.preOrderTotal} >Total</Text>
                    <Text style={styles.preOrderTotal}>{(personOnPremiseTotal(person) + paidperProductsTotal(person) + (parseFloat(person?.tip) || 0)).toFixed(2)} €</Text>
                  </Div>

                  {/* PM: show Food Voucher ONCE only — single summed line for THIS person
                      (singleInvoiceBill has no whole-bill userFoodVoucher summary). */}
                  {(() => {
                    const _fvTotal = (person?.FoodVoucher?.vouchers || [])
                      .reduce((s, el1) => s + ((el1?.count != 0) ? (Number(el1.amount) * Number(el1.count)) : 0), 0);
                    return _fvTotal > 0 ? (
                      <Div style={styles.foodItemContainer}>
                        <Text style={styles.hostProductsStyles}>Food Voucher</Text>
                        <Text style={styles.hostProductsStyles}>{_fvTotal.toFixed(2)}€</Text>
                      </Div>
                    ) : null;
                  })()}

                  {person?.diffPaymentTypes?.map((pt) =>
                    pt.type === 'Card' || pt.type === 'credit-card' ? (
