        </Text>
      </View>

      <View
        style={{
          display: 'flex',
          flexDirection: 'row',
          marginHorizontal: 12,
          justifyContent: 'space-between',
          marginVertical: 4,
        }}>
        <>
          <Text style={{ color: Colors.secondary }}>
            PERSONS: x {appointment?.products?.length + appointment?.guests?.length}
          </Text>
        </>
        <Text
          style={{ color: Colors.secondary }}>
          TICKET: {appointment.ticketId}
        </Text>
      </View>
      {usersList.length > 0 &&
        usersList.map((person, idx) => (
          <>
            {person.show_invoice && singleInvoice == person._id && (
              <Div pt={10} pb={15}>
                <Div
                  py={10}
                  // borderTopWidth={0.5}
                  // borderColor={Colors.borderBlack}
                />
                {person?.products.length > 0 &&
                  person?.products[0].features.length > 0
                  ? person?.products.map((er) => (
                    // ? person?.products.map((er) => er?.key != 'paid_products' && (
                    er.key != 'paid_products' &&
                    (<Div px={10} py={4}>
                      <Div row justifyContent="space-between">
                        <Div justifyContent="center">
                          {er?.splited  ? (
                            <Text style={[styles.hostProductsStyles, {width: wp('22%')}]}>
                              {er.data.name} x{' '}
                              {er.ordered_quantity +
                                '/' + parseInt(er.splitedTo.length + 1)}
                            </Text>
                          ) : (
                            <Text style={[styles.hostProductsStyles, {width: wp('22%')}]}>
                              {er.data.name} x {er.ordered_quantity}
                            </Text>
