# ── GitHub Webhook ───────────────────────────────────────────────────────────
# Secret shared with GitHub to validate the X-Hub-Signature-256 header.
# If unset, signature validation is SKIPPED (dev mode only — never in prod).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=xorstack-admin




# Vyapy Business app (iPad) — waiter + kitchen roles for cross-app scenario
# Consumer (diner) staging login. REQUIRED on any simulator the app has not been
# signed in on -- the platform installs the app itself, so a new Mac or a new
# simulator always starts signed out, and the first-run preamble signs in with
# these. (Can also be set per role in the dashboard: Run Cross-App Suite.)
VYA_CONSUMER_USER=
VYA_CONSUMER_PASSWORD=
VYA_BUSINESS_WAITER_USER=emp2A@xorstack.com
VYA_BUSINESS_WAITER_PASSWORD=
VYA_BUSINESS_KITCHEN_USER=kemp2A@xorstack.com
VYA_BUSINESS_KITCHEN_PASSWORD=

# PR auto-test: pin runs to a specific simulator.
# LEAVE THIS EMPTY unless you have a reason not to. Empty = the platform picks
# your own simulator (prefers one already booted, else an available iPhone) and
# boots it for you. A UDID only exists on the Mac it came from, so a hardcoded
# one here sends every other machine down the "requested device" path for a
# device it does not have.
#   xcrun simctl list devices booted    # to find a UDID, if you really want to pin
PR_TEST_IOS_DEVICE=

# Wipe the app before AND after every agent job, so one PR's run cannot inherit the
# previous run's login, cache or half-finished screen.
# WARNING: a wiped app returns at FIRST-RUN (onboarding, signed out). No consumer
# scenario handles that yet, so leave this off until a first-run preamble exists.
FRESH_INSTALL_PER_JOB=false

# ── Security (required before production) ───────────────────────────────────
# APP_ENV: anything other than dev/development/local/test is treated as
# production, which makes the two secrets below mandatory — the server refuses
# to start (JWT) or to accept unsigned webhooks without them.
APP_ENV=dev
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=
# Shared secret the execution agent presents as X-Agent-Token. Same value must
# be set in the agent's environment.
AGENT_TOKEN=

# ── WebDriverAgent ───────────────────────────────────────────────────────────
# All of these are OPTIONAL. automation/appium_service/wda.py discovers and
# VALIDATES a compatible WDA build on its own; set these only to override it.
#
# Resolution precedence:
#   1. WDA_DERIVED_DATA        explicit path (still validated — never trusted blindly)
#   2. cached path             reused only while the toolchain fingerprint matches
#   3. dynamic discovery       xcuitest driver's build dir, then Xcode DerivedData
#   4. build once              `appium driver run xcuitest build-wda`
#
# A build is only accepted if WebDriverAgentRunner-Runner.app actually contains
# its Info.plist, its Mach-O binary, and the .xctest bundle's binary. An
# interrupted xcodebuild leaves a directory that passes isdir() and cannot launch.
# WDA_DERIVED_DATA=
#
# Base WDA port. Each simulator gets its own (first device 8100, next 8101, …);
# cross-app pins consumer=8100 / business=8101 explicitly.
# WDA_LOCAL_PORT=8100
#
# Ceiling for a WDA launch/build. A cold build measured ~188s on this hardware,
# so 180000 was too tight and Appium dropped the connection mid-build.
# WDA_LAUNCH_TIMEOUT_MS=360000

# ─── Database ──────────────────────────────────────────────────────────────
# MUST be an ABSOLUTE path OUTSIDE this repo. .db files exist in this repo's git
# history, so a checkout or rebase crossing those commits overwrites a live
# database — that is how a full set of projects and scenarios was lost once.
DATABASE_URL=sqlite:////Users/<you>/.vya-platform/platform.db

# ─── AI provider ───────────────────────────────────────────────────────────
# WITHOUT THESE THE PLATFORM DOES NOT ERROR — it silently falls back to a mock
# that returns a hardcoded story about a "login button selector" as if it were
# real analysis. RCA, Weekly Trend and the PR planner will all show fiction.
# Groq is OpenAI-compatible, so it uses OPENAI_API_KEY. Free key:
#   https://console.groq.com  ->  API Keys
LLM_PROVIDER_TYPE=groq
OPENAI_API_KEY=gsk_your_groq_key_here
# llama-3.1-8b-instant was decommissioned by Groq (404 on chat/completions).
# Check what is live:  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
LLM_MODEL_NAME=openai/gpt-oss-20b

# ─── Optional ──────────────────────────────────────────────────────────────
# Where the app's JS console is read from when a step fails. Unset, the most
# recently written /tmp/metro*.log is used.
# METRO_LOG_PATH=/tmp/metro8081.log
