# ── GitHub Webhook ───────────────────────────────────────────────────────────
# Secret shared with GitHub to validate the X-Hub-Signature-256 header.
# If unset, signature validation is SKIPPED (dev mode only — never in prod).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
